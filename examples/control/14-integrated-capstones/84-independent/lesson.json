  "learning": {
    "context": "A variable-speed compressor supplies a receiver while production air demand changes.",
    "reason": "The final assessment must prove independent controller selection from plant requirements rather than reward reproduction of a prescribed advanced method.",
    "theory": [
      "Flow imbalance integrates into receiver pressure.",
      "The installed drive owns the faster delivery inner loop.",
      "PI corrects unmeasured imbalance while qualified demand feedforward acts before pressure error.",
      "Architecture complexity is accepted only when common evidence proves a needed benefit."
    ],
    "workedPrediction": "At 7 bar with 50 percent delivery and demand, pressure rate is zero; a demand step to 65 percent initially produces -0.075 bar/s and qualified one-for-one feedforward requests 15 additional percentage points.",
    "practicalPreparation": [
      "Declare requirements, topology, evidence class, safety ownership, limits and aborts before testing.",
      "Retain bounded request-pulse, demand-imbalance and unused validation records before tuning."
    ],
    "baseline": "Run qualified feedback PI on one reference plant under the common demand record.",
    "change": "Add qualified measured-demand feedforward through the same PID, actuator, anti-windup and tracking boundary on an equivalent plant.",
    "comparison": "Compare pressure, actuator, stability, robustness, abnormal and lifecycle evidence against requirements declared before the run.",
    "validation": "Prove nominal and uncertainty performance, invalid-signal authority, modes, abort, recovery, unchanged revision and explicit unapplied state.",
    "explanation": "Trace the selected architecture from physical imbalance through identification, design and independent evidence instead of selecting it by name.",
    "transfer": "The course is complete; apply the same evidence-first workflow to a new process."
  },
