// Title: Reactor cascade and protection signal path
// Description: An outer reactor PI with measured-load feedforward requests jacket temperature, an inner jacket PI and tracked protection selector command mutually exclusive heating or cooling, and both temperatures close the cascade.
digraph lesson_signal_path {
  graph [rankdir=LR, bgcolor="transparent", pad="0.25", nodesep="0.45", ranksep="0.65", splines=ortho];
  node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#2563eb", fontcolor="#0f172a", fontname="Arial", fontsize=12, margin="0.16,0.10"];
  edge [color="#475569", fontcolor="#334155", fontname="Arial", fontsize=10, penwidth=1.6, arrowsize=0.75];
  RSP [label="Reactor-temperature setpoint", shape=box];
  OUTER [label="Outer reactor PI", shape=box];
  FEED [label="Qualified feed thermal load", shape=box];
  FF [label="Measured-load feedforward", shape=box];
  JSP [label="Jacket-temperature request", shape=box];
  INNER [label="Inner jacket PI", shape=box];
  RT [label="High-temperature protection", shape=box];
  SEL [label="Tracked low selector", shape=box];
  SPLIT [label="Mutually exclusive split range", shape=box];
  STEAM [label="Steam valve", shape=box];
  COOL [label="Cooling-water valve", shape=box];
  JACKET [label="Jacket and reactor", shape=box];
  PVJ [label="Jacket measurement", shape=box];
  PVR [label="Reactor measurement", shape=box];
  RSP -> OUTER;
  FEED -> FF;
  OUTER -> JSP;
  FF -> OUTER;
  JSP -> INNER;
  RT -> SEL;
  INNER -> SEL;
  SEL -> SPLIT;
  SPLIT -> STEAM;
  SPLIT -> COOL;
  STEAM -> JACKET;
  COOL -> JACKET;
  JACKET -> PVJ;
  JACKET -> PVR;
  PVJ -> INNER;
  PVR -> OUTER;
  PVR -> RT;
}
