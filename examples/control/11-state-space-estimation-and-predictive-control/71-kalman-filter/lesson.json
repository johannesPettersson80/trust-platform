  "learning": {
    "context": "A weigh-belt feeder has a known local response and a load-cell signal corrupted by measurement noise and possible bias.",
    "reason": "The deterministic observer from Lesson 65 cannot express separate confidence in model prediction and sensor measurement.",
    "theory": [
      "Mean, variance and covariance describe declared uncertainty before an observation.",
      "The Kalman prediction propagates state and covariance through the feeder model.",
      "Innovation variance determines how much measurement surprise the gain accepts.",
      "Innovation statistics challenge covariance and bias assumptions rather than proving truth automatically."
    ],
    "workedPrediction": "With P=1.9, Q=0.1 and R=3, the first predicted covariance is 1.65559, gain 0.35561, corrected covariance 1.06684, and a 5 kg/s innovation produces a 1.77807 kg/s correction.",
    "practicalPreparation": [
      "Verify equivalent feeder copies, Simulation-truth labels, same noisy samples, timing, seed, command, ranges, estimator state and disabled output.",
      "Declare Q and R before each run and change only one covariance assumption at a time."
    ],
    "baseline": "Apply a fixed alpha=0.2 filter that has no model input, covariance, or innovation-consistency explanation.",
    "change": "Apply the exact discrete feeder prediction and nominal Q=0.1, R=3 Kalman correction to the same samples.",
    "comparison": "Compare nominal, sensor-overtrust, sensor-distrust, biased-sensor, and invalid-covariance records using truth error, two-second mean 90-percent response, movement and innovation diagnostics.",
    "validation": "Accept covariance assumptions only when finite state, truth-error, response, movement and innovation evidence satisfy the predeclared requirements.",
    "explanation": "Q and R change model-versus-measurement trust; a missing bias state leaves a persistent inconsistency that smoothing cannot repair.",
    "transfer": "Lesson 72 continues with LQG."
  }
