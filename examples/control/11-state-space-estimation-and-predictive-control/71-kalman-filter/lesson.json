  "baseline": {
    "executableId": "WeighFeeder.FixedAlphaEstimate",
    "settings": {
      "fixedFilterCoefficient": 0.2,
      "kalmanSelected": false
    },
    "limitation": "A fixed smoothing coefficient cannot express separate model and sensor uncertainty or produce model-consistency diagnostics."
  },
  "change": {
    "executableId": "WeighFeeder.QualifiedScalarKalman",
    "settings": {
      "processNoiseVariance": 0.1,
      "measurementNoiseVariance": 3,
      "kalmanSelected": true,
      "discreteModelA": 0.904837418,
      "discreteModelB": 0.095162582
    },
    "decision": "Accept covariance settings only when truth-error, response, movement, innovation and fault evidence agree with the declared model and noise assumptions."
  },
