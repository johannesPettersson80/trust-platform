  "learning": {
    "context": "Two coupled office zones share constrained heating while weather, occupancy and tariff changes are forecast.",
    "reason": "Reactive or unconstrained feedback cannot coordinate several future coupled moves under hard limits.",
    "theory": [
      "MPC defines decisions, a prediction model, objective, horizon and hard constraints before solving.",
      "The shipped optimizer exhaustively evaluates 729 finite-grid sequences every valid interval.",
      "Receding horizon applies one move and resolves after the next measurement.",
      "Completed-search infeasibility and invalid solver configuration are distinct states with explicit PI fallback."
    ],
    "workedPrediction": "At 21 degC in both zones with 5 degC outdoors and previous heat 80/80 percent, the zero-move sequence predicts 21 degC and is feasible on all declared limits.",
    "practicalPreparation": [
      "Verify the coupled model, interval, schedule, three forecast positions, move grid, horizon, weights, limits, PI state and disabled output.",
      "Reproduce one 729-sequence result with the independent enumeration oracle before operating the normal schedule."
    ],
    "baseline": "Run the qualified bounded incremental PI pair against the twenty-minute schedule without forecast access.",
    "change": "Run the three-step finite-grid optimizer against the identical plant and schedule, applying only each solve's first move.",
    "comparison": "Compare temperature error, comfort violation, tariff-weighted use, heater movement, power peaks, active constraints, solves and fallback on common evidence.",
    "validation": "Prove oracle agreement, normal feasibility, explicit completed-search infeasibility, invalid-configuration fallback, recovery and disabled output.",
    "explanation": "Preview changes current decisions through predicted future cost and constraints; clipping a reactive command does not perform that optimization.",
    "transfer": "Lesson 74 continues with Lyapunov stability."
  }
}
