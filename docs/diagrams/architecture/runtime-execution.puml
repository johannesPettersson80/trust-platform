@startuml runtime-execution
!theme plain
allowmixing
skinparam backgroundColor #FEFEFE
skinparam componentStyle uml2
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 35

title truST Runtime: Admitted Ownership and Hosted Cycle

package "Non-executable authoring" as authoringPkg #LightYellow {
    component "CompileSession / LoweredApplication\nsource lowering, declarations and recipes\n(host/harness/build.rs)" as lowered
    component "RuntimeBuilder\nconstruction-only registry, storage and bindings\n(runtime/builder.rs + builder/seeds.rs)" as builder
    component "BytecodeAuthoringView\nborrowed producer inputs" as authoringView
    component "bytecode/encoder\nSTBC 3.0 producer / explicit compatibility output" as producer
    artifact "STBC 3.0 / legacy 2.0\ncode, types, roots, initializers,\nresources and persistent references" as artifact
    component "Explicit legacy import\nsupplied 1.1 bodies + LoweredApplication\n(encoder/legacy_import.rs)" as legacyImport
    component "Legacy 1.1 producer startup\nnon-executable builder construction\n(host/harness/build/legacy_construction.rs)" as legacyAuthoring
    lowered --> legacyAuthoring : explicit compatibility producer
    legacyAuthoring --> authoringView
    lowered *-- builder
    builder --> authoringView
    authoringView --> producer
    lowered --> producer
    producer --> artifact
    lowered --> legacyImport : construction context
    legacyImport --> artifact : retain supplied instruction bodies
}

package "Admission and one execution owner" as ownerPkg #LightGreen {
    component "trust-runtime-core::bytecode\ndecode + validated token\nframing, CRC, types and bounded analysis" as admission
    component "PreparedModule\nprofile admission + construction indexes\nimmutable VM, registry and optional register plans" as prepared
    class "Hosted Runtime\n(runtime/installed.rs)" as runtime {
        private state: OwnedRuntimeState<HostedExecutionServices>
        private metadata: Arc<RuntimeMetadata>
        private artifact: immutable deployment archive
        private io / ads / opcua / links / hmi / retain / metrics / watchdog
        private simulation_enabled / cycle_task_runs
        --
        execute_cycle()
        simulated_target() / program_ran_in_last_cycle()
        checked value / reference / image writes
        candidate replacement / resource reconfiguration
    }
    component "Target fact: Runtime::simulated_target()\nsimulation enabled AND all I/O simulation-only\nAND no ADS or OPC UA client connection" as targetFact
    runtime --> targetFact : the one target fact for every live write
    component "OwnedRuntimeState<S> / RuntimeState\nshared EngineData owner\n(core/vm/engine/owned.rs + api.rs)" as state
    component "EngineState\nprivate operation-scoped context\nchecked types, paths, lifetimes and work" as context
    component "EngineData\nVariableStorage, images, task timing,\nconstruction, budgets, fault and IR selection" as data
    component "RuntimeMetadata\nread-only tooling projection\nHIR types/source retained only in full host" as metadata
    component "HostedExecutionServices\nclock, deadline, observer, captured register config,\nconversion profile, controller measurements" as hostServices
    component "Source-free hosted Runtime\n(host/runtime_only.rs)" as runtimeOnly
    component "Shared std UTC clock\n(host/host_clock.rs)" as hostClock
    runtimeOnly *-- state
    runtimeOnly --> hostClock
    hostServices --> hostClock
    artifact --> admission
    admission --> prepared
    prepared --> state : prepare before installation
    runtime *-- state : sole mutable PLC authority
    runtime *-- metadata
    runtime --> hostServices
    state --> context : temporary exclusive operation
    context --> data : checked access
    state *-- data
    metadata ..> prepared : wire types / references / source labels
    context --> hostServices : narrow service callbacks
    note bottom of runtime
        Installed storage and executable schema have no raw mutable getter.
        Full/development keep hosted tools and services; runtime-only owns the
        same core state with a thin std clock/deadline adapter and no compiler/HIR graph.
        Every composition retains the full PLC function set.
        Export copies admitted artifact data; it never serializes current PLC values.
    end note
}

package "Shared execution representations" as executionPkg #LightCyan {
    component "PreparedRegisterPlans\noptional register-ir feature\neager lowering and specialized blocks" as plans
    component "Core register executor\npre-reserved per-POU scratch + bounded selection" as registers
    component "Core stack dispatcher\nshared bytecode opcode loop; no-register calls stay in-loop" as stack
    component "Register-enabled VM activation pump\niterative mixed stack/register calls\nleased parent scratch and common completion" as pump
    component "Common ExecutionContext\ncall/return, references, output transactions,\nlibm numerics and full standard library" as semantics
    prepared --> plans
    context --> stack : no register-ir feature
    context --> pump : register-ir feature
    pump --> registers : eligible prepared plan / scratch available
    pump --> stack : unsupported plan / occupied recursive scratch
    plans --> registers
    registers --> pump : deferred POU call
    stack --> pump : register-ir stack activation yields cursor
    pump --> semantics : return validation / common copyback
    registers --> semantics : immediate native operation
    stack --> semantics : immediate native operation
    semantics --> context
    note bottom of semantics
        Both representations use one entry allowance and the same deadline,
        frame cleanup, reference policy and bytecode instruction costs.
        Yield and resume do not re-charge bytecode or repeat block-entry hooks.
        The stack dispatcher and register-enabled pump keep native stack use
        independent of admitted POU depth. In no-register builds, native stack
        callees push frames and restore cursor continuations inside the same loop.
        Both return through one call binding/completion owner and opcode interpreter.
        No lowering, source evaluation or first-use compilation runs in RUN.
        Optimization fallback never removes PLC functionality.
    end note
}

package "Hosted cycle: borrowed adapters, common scheduler" as cyclePkg #LightBlue {
    component "ResourceRunner\nlogical clock, supervision, STOP and simulation\n(scheduler + host/simulation.rs)" as runner
    card "Simulation pre-cycle\ndisturbances + delayed input effects" as simulationPre
    card "CycleStart\npending value/lvalue requests + debug event" as cycleStart
    card "BeforeInputSample\nphysical inputs; debug I/O writes and forces" as inputAcquire
    card "Common mapped-input sample\nthen ADS / OPC UA cached inputs\nthen link states -> every Comm.Link block (spec 42)" as inputSample
    card "Common readiness and priority/due/index order\nready tasks + admitted background programs\npaired program metrics, including faults" as readyWork
    card "TaskStart / TaskEnd boundaries\nControl Studio parameter and transfer commit,\nthen confirm or revert, through checked writes\n(spec 35; the target fact decides approval)" as taskBoundary
    card "BeforeOutputSample\nretain checkpoint/save before output conversion" as retainPhase
    card "Normal %Q/%M sample\nthen variable/I/O forces, protocol capture,\ncontrol snapshot with task runs and target fact" as outputSample
    card "Deadline check and driver submission\nflat Q commits after every driver succeeds" as outputCommit
    card "Hosted telemetry + final deadline\nhealth, CycleEnd, metrics and cycle count" as step9
    card "Between scans, after a successful scan\ndebug snapshot of the completed scan + transfer finish;\nHMI exchange when Hmi.Display was called:\ncommands, method calls, screen copy, alarms (spec 39 §18)" as afterScan
    card "Simulation post-cycle\nobserve outputs; enqueue future effects" as simulationPost
    runner --> simulationPre
    simulationPre --> runtime
    runtime --> cycleStart : execute_cycle / HostedCycle
    cycleStart --> inputAcquire
    inputAcquire --> inputSample
    inputSample --> readyWork
    readyWork --> taskBoundary : each due task
    readyWork --> retainPhase
    retainPhase --> outputSample
    outputSample --> outputCommit
    outputCommit --> step9
    step9 --> afterScan
    afterScan --> simulationPost
    readyWork --> context : one core scheduler
    hostServices ..> readyWork : deadline + debug observer
    note bottom of outputCommit
        Failure before successful submission restores touched flat Q windows only.
        Marker/hierarchical effects keep the established hosted rollback domain.
        A late deadline/telemetry fault cannot undo outputs accepted by drivers.
        Invalid management requests produce WriteRejected, not a PLC fault;
        actual execution/adapter/deadline failures follow the fault policy.
    end note
}

package "Scheduler and Process Time" as schedulerPkg #LightBlue {
    rectangle "Resource loop (scheduler/runner_loop.rs)" as resourceLoop #Wheat {
        card "1. Apply pause, resume and restart\n(pause and resume restart the schedule)" as loopCommands
        card "2. begin_cycle(wall time, cycle interval)\n→ slot with the cycle's process time" as loopBegin
        card "3. set_current_time(process time), then\nexecute_cycle() between the simulation\npre-cycle and post-cycle hooks" as loopExecute
        card "4. finish_cycle(slot)\nsleep until the next due instant" as loopFinish
    }

    rectangle "Cycle timing (scheduler/cycle_timing.rs)" as cycleTiming #Wheat {
        card "Without simulation\nprocess time = wall clock\n(a late cycle counts as an overrun)" as wallTime
        card "With simulation\none exact step per executed cycle;\nnever read from the wall clock" as simStep
    }

    rectangle "Simulation speed (scheduler/simulation_clock.rs)" as simSpeedPkg #Wheat {
        card "SimulationSpeed\nshared time_scale 1..100\nset by config.set simulation.time_scale" as speedCard
        card "Pace = cycle interval / time_scale\na late cycle still advances simulation time\nby exactly one interval" as paceCard
        card "AchievedSpeedWindow\nsimulation span / wall span over the\nlast 5 s, reported after 1 s of wall time" as achievedCard
    }

    loopCommands --> loopBegin
    loopBegin --> loopExecute
    loopExecute --> loopFinish
    loopBegin --> cycleTiming : begin_cycle(wall time, cycle interval)
    speedCard --> paceCard : speed in force
    paceCard --> loopFinish : next due instant
    simStep --> achievedCard : simulation time per wall time
}

runner ..> resourceLoop : runs the resource loop

package "Lifecycle and checked engineering" as lifecyclePkg #LightGray {
    component "ResourceReconfiguration\nstage admitted images/tasks; exclusive commit\n(core/engine/reconfiguration.rs)" as resourceChange
    component "Isolated code/schema candidate\nprepare_replacement + warm retain migration\n(runtime/installed_lifecycle.rs)" as codeChange
    component "Safe-state delivery\nchecked owner images + every driver attempt\n(io_subsystem + installed_cycle.rs)" as safeState
    component "Retain checkpoint and restart\ncanonical global/program destinations\n+ FB-instance members (@program-instance/@global-instance)\nSTRN v3: logical values + physical layout/backing\nchecked capture + transactional restoration;\n%M markers committed from their variables (spec 11 §6.5)" as retainOwner
    component "Startup composition\nselected transports / T0 SHM / Linux RT posture" as startup
    component "Launcher signals / ResourceControl\nSTOP, safe outputs, durable save" as shutdown
    component "Faulted wait\nno tasks or outputs; serves reads and config;\nrestart / online change resume; STOP ends\n(scheduler/faulted.rs)" as faultedWait
    component "Hang supervisor (watchdog enabled)\nindependent thread reads the published deadline;\nWatchdogTimeout + hang_action fault | abort (exit 70)\n(scheduler/supervisor.rs)" as hangSupervisor
    runtime --> resourceChange : metadata / direct / MQTT bindings
    resourceChange --> state : preserve values, live identities, debug/IR/fault state
    runtime --> codeChange : source/bytecode schema replacement
    codeChange --> state : publish only fully prepared candidate
    runtime --> retainOwner
    runner --> safeState : STOP / FAULT / watchdog
    runner --> faultedWait : halting fault (process keeps serving)
    faultedWait --> runner : successful restart / online change
    hangSupervisor ..> runner : cycle deadline; declares a hung scan Faulted
    safeState --> state : separate checked safety entry
    startup --> runner
    shutdown --> runner
    shutdown --> safeState
    shutdown --> retainOwner
    note bottom of resourceChange
        Resource-only edits do not execute initializers or reconstruct PLC values.
        Binding-only edits preserve task timing; explicit task replacement samples
        SINGLE and resets registration timing while retaining thread identity history.
        Failure or discarded candidate leaves the installed state unchanged.
    end note
}

package "Detached debugger inspection" as debugPkg #MistyRose {
    component "StatementFrame\nread-only current and suspended invocations" as frameView
    component "DebugSnapshot::from_execution\nphysical local slots, ancestor identities\n(host/debug/execution_snapshot.rs)" as debugSnapshot
    component "DAP / DebugControl\nconditions, watches, queued writes and forces" as dap
    component "Scratch TypeRegistry / detached expression state\ncompiler slots hidden from presentation\n(trust-debug evaluation)" as scratch
    context --> frameView
    frameView --> hostServices
    hostServices --> debugSnapshot
    metadata --> debugSnapshot
    debugSnapshot --> dap
    dap --> scratch : expression parsing / detached edits
    dap --> cycleStart : queued next-scan application; stale destinations reject
    dap --> runtime : synchronous checked engineering operations
    note bottom of debugSnapshot
        Snapshot mutation never copies back into live invocation locals.
        Candidate construction emits no active debugger observations.
        Debug pause does not grant mutable schema or raw PLC storage access.
    end note
}

package "Control + Web Contract" as controlWebPkg #Lavender {
    rectangle "Bounded Web Dispatch (web/request_dispatch.rs)" as webDispatch #Wheat {
        card "accept loop\n(request admission only)" as webAccept
        card "read lane\n4 workers + 32 queued" as webReadLane
        card "body/mutating lane\n4 workers + 4 admitted" as webBodyLane
        card "saturation response\n503 + Retry-After + server_busy" as webBusy
    }

    rectangle "Control API (control/transport.rs + control/* handlers)" as controlApi #Wheat {
        card "historian.query / historian.alerts\n(persistent samples + alert transitions)" as controlHistorian
        card "status (status_handlers.rs)\nsimulation_time_scale,\nsimulation_achieved_time_scale" as statusCard
        card "config.set simulation.time_scale\n(config_handlers_set.rs)\nrefused without simulation; next cycle" as configSpeedCard
        card "live-write handlers: experiment, transfer,\nparameter, controller (control/*_handlers.rs)\nthe latest scan's target fact decides; a source\nlabel must agree; no write before the first scan" as liveWriteCard
    }

    rectangle "Web Server (web/*)" as webServerRoutes #Wheat {
        card "GET /metrics\n(Prometheus scrape, auth-gated)" as webMetrics
        card "transport:\nHTTP (local) or HTTPS (runtime.web.tls=true)" as webTransport
    }

    rectangle "Web IDE Preview (/ide)" as ideWeb #Wheat {
        card "GET /ide + /ide/modules/ide-*.js\n(preview shell + modular UI bundles)" as ideRoute
        card "Hardware tab\nasync config hydration + ARIA route state" as ideHardware
        card "communication graph relayout\nlatest frame wins\none post-hydration resize/fit" as ideHardwareLayout
        card "GET /api/ide/capabilities\n(scope + limits + mode)" as ideCaps
        card "POST /api/ide/session\n(auth -> session token)" as ideSession
        card "GET /api/ide/files\n(list sources/**/*.st)" as ideFiles
        card "GET /api/ide/file\n(open path + version)" as ideOpen
        card "POST /api/ide/file\n(expected_version + content)" as ideWrite
    }

    rectangle "Terminal Console (ui/*)" as tuiContract #Wheat {
        card "ui.rs facade:\nrun_ui loop + orchestration" as tuiFacade
        card "client.rs:\nendpoint/auth + control transport" as tuiClient
        card "parsing.rs + state.rs:\nsnapshots + prompt/session state" as tuiState
        card "input.rs + commands/*:\nkey handling + action routing" as tuiInput
        card "render.rs:\npanel/prompt presentation" as tuiRender
    }

    ideRoute --> ideCaps
    ideRoute --> ideHardware
    ideHardware --> ideHardwareLayout
    ideCaps --> ideSession
    ideSession --> ideFiles
    ideFiles --> ideOpen
    ideOpen --> ideWrite
    webAccept --> webReadLane
    webAccept --> webBodyLane
    webReadLane --> webMetrics
    webReadLane --> ideRoute
    webBodyLane --> ideRoute
    webReadLane --> webBusy : full
    webBodyLane --> webBusy : full
    tuiFacade --> tuiClient
    tuiFacade --> tuiState
    tuiFacade --> tuiInput
    tuiFacade --> tuiRender

    note right of ideWrite
        security boundary:
        • web auth required for session bootstrap
        • optional TLS (runtime.web.tls + runtime.tls cert material)
        • X-Trust-Ide-Session required for calls
        • writes allowed only in debug mode
        • optimistic conflict check via expected_version
        • source scope limited to sources/**/*.st
    end note

    note right of webServerRoutes
        web transport boundary:
        • accept loop + HTTP lifecycle in web/server.rs
        • bounded admission/workers in web/request_dispatch.rs
        • incomplete bodies cannot occupy the read lane
        • saturation fails with stable 503 server_busy
        • route handlers split by concern in web/*_routes.rs
    end note

    rectangle "HMI display (/hmi, web/hmi_* + hmi/*)" as hmiDisplay #Wheat {
        card "HmiExchange\nqueued commands, settings, one-off reads\n(at most 1,024 each; then request queue full)" as hmiExchange
        card "screens, faceplates, texts, symbols, images\nread from hmi/ only; never a link or io.toml" as hmiFiles
        card "method commands\ninput-only interface methods through\nthe shared engine's method entry" as hmiMethods
    }
    hmiExchange --> hmiMethods
    note right of prepared
        Initializers flow through the
        runtime initializer service:
        TYPE/member defaults, aggregate
        VAR initializers, VAR_CONFIG,
        and FB member overrides.

        Materialization priority:
        retained value > VAR_CONFIG override
        > variable initializer > TYPE/member
        defaults > zero/type default.

        Struct/union construction ends at
        StructValue::new or an equivalent
        validation boundary.
    end note
}

' ============================================================
' OPC UA INTEROP
' ============================================================
package "OPC UA Interop" as opcuaPkg #LightCyan {
    rectangle "OPC UA Gateway (opcua.rs)" as opcuaFlow #Wheat {
        card "1. Load runtime.opcua profile" as opc1
        card "2. Bootstrap endpoint + namespace" as opc2
        card "3. Startup probe read\n(reference client session)" as opc3
        card "4. Poll runtime snapshot\n(refresh exposed node values)" as opc4
        card "5. External clients\nbrowse/read/write nodes" as opc5
    }

    opc1 --> opc2
    opc2 --> opc3
    opc3 --> opc4
    opc4 --> opc5
}

' ============================================================
' ADS CLIENT INTEROP
' ============================================================
package "ADS Client Interop" as adsPkg #LightCyan {
    rectangle "ADS Symbol Bridge (host/ads)" as adsFlow #Wheat {
        card "1. runtime.toml [runtime.ads]\n+ ads.toml + cached symbol snapshot" as ads1
        card "2. Generate single project-level\nsrc/generated/ads_generated.st" as ads2
        card "3. Compile generated globals\nas normal ST metadata" as ads3
        card "4. Bundle startup resolves declared global\n-> ValueRef + TypeId and starts workers" as ads4
        card "5. Worker thread owns ADS transport\nsum-up read/write + notifications\n+ symbol-version checks" as ads5
        card "6. Shared cache stores\nValue + PointQuality" as ads6
        card "7. Scan boundary copies cache\nand queues write intents only" as ads7
    }

    ads1 --> ads2
    ads2 --> ads3
    ads3 --> ads4
    ads4 --> ads5
    ads5 --> ads6
    ads6 --> ads7

    note right of ads7
        The scan thread performs no ADS
        socket operations. Network reads,
        writes, notifications, reconnects,
        and symbol-version revalidation
        stay on the worker thread.
    end note
}

' ============================================================
' ADS SERVER INTEROP
' ============================================================
package "ADS Server Interop" as adsServerPkg #LightCyan {
    rectangle "ADS Server (host/ads/server + trust-ads-server)" as adsServerFlow #Wheat {
        card "1. runtime.toml [runtime.ads_server]\nvalidates listen, AMS identity,\nsource-pinned clients, limits" as adsServer1
        card "2. Runtime startup begins\nADS server listener on TCP 48898" as adsServer2
        card "3. External ADS client\nTwinCAT / pyads / .NET connects\nto logical AMS port 851" as adsServer3
        card "4. Protocol engine serves\nsymbol upload, read, sum-up read,\nand notifications" as adsServer4
        card "5. Snapshot publisher reads\nruntime globals without touching\nscan socket paths" as adsServer5
        card "6. Optional writes pass\nallowlist + writable + audit gates" as adsServer6
        card "7. Runtime write port queues\naccepted writes at runtime boundary" as adsServer7
    }

    adsServer1 --> adsServer2
    adsServer2 --> adsServer3
    adsServer3 --> adsServer4
    adsServer4 --> adsServer5
    adsServer4 --> adsServer6
    adsServer6 --> adsServer7

    note right of adsServer4
        ADS server parser handles
        untrusted AMS/TCP frames with
        size, sum-up, client, and
        subscription caps.
    end note

    note right of adsServer7
        ADS writes are disabled by
        default and audited as
        ads.server.write when accepted
        or rejected.
    end note
}

' ============================================================
' CONNECTOR STATUS CONTRACT
' ============================================================
package "Connector Status Contract" as connectorPkg #Lavender {
    card "contract.rs\nschema_version + state/health/\nconfidence/point quality" as connectorContract
    card "mapping.rs\nreviewed source-state ->\nconnector-state table" as connectorMapping
    card "adapters/*\nprotocol projections only;\nno transport loops" as connectorAdapters
    card "report.rs\nstable report assembly" as connectorReport
    card "control/connectors_handlers.rs\nViewer-gated connectors.status\nread surface" as connectorControl

    connectorContract --> connectorMapping
    connectorMapping --> connectorAdapters
    connectorAdapters --> connectorReport
    connectorReport --> connectorControl
}

opcuaFlow ..> connectorAdapters : project OPC UA\nstatus only
adsFlow ..> connectorAdapters : project ADS client\nstatus only
adsServerFlow ..> connectorAdapters : project ADS server\nstatus only
step9 ..> connectorAdapters : project IoDriver\nhealth only


package "I/O and protocol composition" as ioPkg #LightGray {
    component "IoSubsystem\nimmutable binding schema + physical drivers" as ioSubsystem
    component "InstalledIoView\nborrows authoritative core images\nselected-value inspection only" as ioView
    interface "IoDriver\nread_inputs / write_outputs / health" as driver
    component "Modbus / MQTT session workers\nwire operations off the scan thread" as workers
    component "Gpio / EtherCAT adapters\nplatform I/O and failure policy" as hardwareIo
    component "MQTT tag mapping / direct bindings\nadmitted resource transaction before worker start" as bindings
    runtime --> ioSubsystem
    ioSubsystem --> ioView
    ioView --> data : read-only image borrow
    ioSubsystem --> driver
    driver --> workers
    driver --> hardwareIo
    inputAcquire --> ioSubsystem : direct core input image
    outputCommit --> ioSubsystem : authoritative output image
    safeState --> ioSubsystem : all drivers; first failure reported
    bindings --> resourceChange
    ads7 --> inputSample : cached inputs at checked port
    outputSample --> ads7 : capture intents after forces
    opcuaFlow ..> inputSample : OPC UA client cache adapter
    outputSample ..> opcuaFlow : checked output capture
    hmiExchange --> runtime : served between scans (checked writes, reads)
    hmiDisplay --> metadata : declared types
    controlApi --> runtime : live writes decided by the target fact
    connectorAdapters ..> ioSubsystem : status projection only
}

package "Private historical corpus" as historicalPkg #Gainsboro {
    component "cfg(test) LegacyRuntimeFixture\nold core/cycle/VM and explicit 1.1 fixtures\nnot reachable from production Runtime" as historical
    component "Non-executable helpers\nconst folding / source lowering / detached debug evaluation" as helpers
    helpers --> builder
    helpers --> scratch
    historical ..> authoringView : private fixture authoring only
}

legend right
    Source ownership view; validation, rendering and hardware evidence are separate.
    Production execution uses the canonical shared core and an admitted artifact.
    Host services borrow checked ports; no second mutable PLC store or dispatcher.
    Retained state remains ordinary global/instance storage with declared policy.
    Platform capabilities and performance must be verified in their selected composition.
end legend
@enduml
