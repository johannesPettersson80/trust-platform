' I/O INTERFACE
' ============================================================
package "I/O Interface" as ioPkg #LightGray {

    class "IoSubsystem" as ioSubsystem {
        interface: IoInterface
        drivers: Vec<IoDriverEntry>
        safe_state: IoSafeState
        --
        +apply_safe_state()
        +update_health()
    }

    class "IoInterface" as ioIface {
        inputs: Vec<u8>
        outputs: Vec<u8>
        memory: Vec<u8>
        bindings: Vec<IoBinding>
        binding_codecs: Vec<IoBindingCodec>
        --
        +read(address) → Value
        +write(address, value)
        +snapshot() → declared type metadata + value state
    }

    interface "IoDriver" as ioDriver {
        +read_inputs(io)
        +write_outputs(io)
    }

    component "io/modbus/worker.rs\n(latest input snapshot +\nlevel output handoff)" as modbusWorker
    component "io/mqtt/worker.rs\n(session worker + freshness +\nlevel output handoff)" as mqttWorker
    component "io/mqtt_tag_mapping.rs\n(resolve ProgramInstance.Variable\n+ lower to typed process-image points)" as mqttTagMapping
    component "io/ethercat/driver.rs\n(hardware construction failure ->\nterminal until driver rebuild)" as ethercatDriver

    ioSubsystem --> ioIface
    ioSubsystem --> ioDriver : uses
    ioDriver ..> modbusWorker : Modbus scan calls\nbounded handoff only
    ioDriver ..> mqttWorker : MQTT scan calls\nbounded handoff only
    runtime ..> mqttTagMapping : apply bytecode first, then\nresolve all mappings atomically
    mqttTagMapping --> ioIface : reuse or allocate typed\n%I/%Q bindings + enum codecs\nbefore worker start
    mqttTagMapping ..> mqttWorker : validated input/output\npoint topics
    ioDriver ..> ethercatDriver : EtherCAT scan calls\nfail closed on unavailable hardware
    modbusWorker ..> ioDriver : owns sync\nModbus protocol path
    mqttWorker ..> ioDriver : owns sync\nMQTT protocol path

    note right of mqttWorker
        Phase 3B worker/snapshot contract:
        Modbus/MQTT connect, poll, and
        wire round trips stay off the scan
        thread. Driver health still projects
        through IoDriverHealth.
    end note

    note right of mqttTagMapping
        MQTT mapping direction is PLC-relative:
        read = broker to PLC input,
        write = PLC output to broker.
        Output-only mappings neither subscribe
        nor clear shared input bytes. Read-only
        mappings publish no raw output fallback.
        Present-but-empty mappings disable both
        raw directions; only absent mappings use
        the default raw topics.
        Enum identity stays at the process-image
        binding; MQTT carries the numeric member,
        while snapshots carry the declared enum
        name for value, error, and unresolved states.
    end note

    note right of ethercatDriver
        EtherCAT hardware construction that
        fails after ethercrab storage split is
        bounded to the driver instance. The
        driver reports unavailable hardware
        until the runtime rebuilds the driver
        instead of retrying allocation in
        scan-cycle retry windows.
    end note
}

