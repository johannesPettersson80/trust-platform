@startuml
title Phase 17 Code-to-Spec Coverage + Phase 18 Test-Mapping Accelerator

skinparam componentStyle rectangle
skinparam shadowing false

package "Authoritative source denominators" {
  [Cargo metadata + Rust module graph] as RustUniverse
  [Shipped TypeScript/JavaScript roots] as TsUniverse
  [Verification tooling roots] as ToolUniverse
  [Gate inventory] as GateInventory
  [Fuzz targets + direct surface areas] as FuzzInventory
  [Verification matrix area owners] as AreaOwners
  [private input digest manifest] as PrivateInputs
}

package "Parser-backed fact extraction" {
  [syn Rust extractor] as RustExtractor
  [TypeScript compiler API extractor] as TsExtractor
  [Python AST + shell entrypoints] as ToolExtractor
  database "Stable CODE facts\nsignature + body digests\nrisk signals" as Facts
}

package "Reviewed verification graph" {
  [code-spec-map.toml] as Map
  [exact risk acknowledgement ledger] as RiskAcks
  [delete-only debt baseline] as Debt
  [spec sources + unresolved gaps] as Specs
  [invariants + test catalog] as VerificationGraph
  [exact Markdown fragment resolver] as FragmentResolver
  [exact semantic join] as Join
}

package "Live test denominator" {
  [test scanners] as TestScanners
  database "Stable DISC facts" as TestFacts
  [reviewed denominator + exact per-file resolver] as FocusedResolver
}

package "Execution-guided mapping accelerator" {
  [Rust nextest + LLVM profiles] as RustTrace
  [direct ST / conformance adapter] as DirectTrace
  [VS Code c8 adapter] as VsCodeTrace
  [structural explicit route] as StructuralTrace
  database "source-bound per-test trace" as Trace
  [deterministic candidate + demand join] as CandidateJoin
  database "quarantined proposals\nC1 / C2 / C3" as Proposals
  database "review decisions" as Decisions
  [exact assertion-to-oracle review] as SemanticReview
  [recoverable atomic catalog transaction] as CatalogTransaction
}

package "Code-map refresh quarantine" {
  [deterministic finding partition] as CodeRefreshBuilder
  database "review-required code-map proposals" as CodeRefreshProposals
}

package "Existing enforcement path" {
  [canonical JSON + Markdown report] as Report
  [report / changed / full policy] as Policy
  [verification report gate] as Gate
  [changed-file planner] as Planner
  [verification-gate workflow] as Workflow
}

[full software map] as SoftwareMap
[primary metadata validator] as MetadataGate
[test-catalog.toml] as TestCatalog
[test-catalog-denominator.toml] as TestDenominator

RustUniverse --> RustExtractor
TsUniverse --> TsExtractor
ToolUniverse --> ToolExtractor
PrivateInputs --> ToolExtractor : bind ignored hook bytes
GateInventory --> ToolExtractor : exact join
FuzzInventory --> ToolExtractor : exact path / target join
RustExtractor --> Facts
TsExtractor --> Facts
ToolExtractor --> Facts
Facts --> Join
Map --> Join
RiskAcks --> Join : exact code / digest / owner / expiry
Debt --> Join
Specs --> FragmentResolver
FragmentResolver --> Join : exact heading anchors
VerificationGraph --> Join
FuzzInventory --> Join : direct surface area
AreaOwners --> Join : canonical owner for area
TestScanners --> TestFacts
TestDenominator --> FocusedResolver : reviewed DISC identity
TestFacts --> FocusedResolver : final campaign refresh only
FocusedResolver --> RustTrace : focused Rust files only
TestFacts --> DirectTrace
TestFacts --> VsCodeTrace
TestFacts --> StructuralTrace
RustTrace --> Trace
DirectTrace --> Trace
VsCodeTrace --> Trace
StructuralTrace --> Trace
Trace --> CandidateJoin : observed CODE identities only
Facts --> CandidateJoin
Map --> CandidateJoin : specified invariant joins
Specs --> CandidateJoin : spec-gap demand
VerificationGraph --> CandidateJoin : oracle-backed behavior rows
CandidateJoin --> Proposals : ranking signals only
Proposals --> SemanticReview
Decisions --> CandidateJoin : suppress unchanged rejection
SemanticReview --> Decisions
SemanticReview --> CatalogTransaction : explicit accepted batch only
CatalogTransaction --> TestCatalog
CatalogTransaction --> TestDenominator
CatalogTransaction --> Decisions
Join --> Report
Report --> CodeRefreshBuilder : at-rest-canonical observations
Map --> CodeRefreshBuilder : byte-identical source mapping
CodeRefreshBuilder --> CodeRefreshProposals : stable IDs + exact partition
Report --> Policy
Policy --> Gate
Report --> Planner : reuse one scan
Specs --> Planner : actionable gaps only
Planner --> Gate
Gate --> Workflow
RustExtractor --> SoftwareMap : consume Phase 17 facts
Map --> MetadataGate : static schema validation
RiskAcks --> MetadataGate : closed schema validation
Debt --> MetadataGate : static schema validation
PrivateInputs --> MetadataGate : schema + live digest
Proposals --> MetadataGate : quarantine + staleness validation
CodeRefreshProposals --> MetadataGate : closed schema only
Decisions --> MetadataGate : closed decision schema
TestCatalog --> VerificationGraph
TestDenominator --> Report : reviewed live denominator

note bottom of Proposals
  Pending and rejected proposals are quarantined.
  They do not feed catalog, coverage, debt retirement,
  proof, claims, or zero-equation counts.
end note

note bottom of SemanticReview
  Coverage, names, paths, and mutation kills are not semantic proof.
  Each assertion is bound to exact oracle behavior rows;
  high-risk mappings require two distinct reviewers.
end note

note bottom of FocusedResolver
  Focused pilot and implementation shards reconstruct only requested
  reviewed source files and fail on stale identity. They do not rerun
  the whole-repository test scanner. The scanner remains authoritative
  for the single final denominator campaign.
end note

note bottom of CodeRefreshProposals
  This plane has no write edge into the accepted map.
  Reported facts stay untrusted until live reconstruction.
  It cannot infer bindings, close gaps, promote proof,
  or refresh digests without an explicit reviewed transaction.
end note

note bottom of Report
  Mapping reports carry proof_kind = none.
  Code coverage cannot promote product proof,
  close a specification gap, or replace rendered UI evidence.
end note

note bottom of Specs
  registered_backlog remains unresolved for exact fact bindings
  but is excluded from planner area expansion.
end note

@enduml
