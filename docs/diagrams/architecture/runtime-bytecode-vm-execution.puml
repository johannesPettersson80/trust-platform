@startuml runtime-bytecode-vm-execution
!theme plain
allowmixing
skinparam backgroundColor #FEFEFE
skinparam componentStyle uml2
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 35

title truST Runtime: Prepared Shared Execution and Checked Host Boundaries

package "Construction and immutable code" as preparationPkg #LightYellow {
    component "RuntimeBuilder / LoweredApplication\nconstruction-only source registry and values" as builder
    component "bytecode::encoder\nSTBC 3.0 declarations, roots, actions and recipes" as encoder
    component "Explicit legacy context importer\nsupplied 1.1 code + lowered construction context" as legacy
    artifact "STBC 3.0 deployment artifact (legacy 2.0 readable)\ncode, TYPE_TABLE, references, resource and debug records" as artifact
    component "core::bytecode::decode / validate\nCRC, bounded counts, typed instructions,\nstaging visibility and memory/work limits" as validation
    component "PreparedModule\nfallible profile/import admission\nimmutable VM + indexes + standard-library descriptors" as prepared
    component "PreparedRegisterPlans\noptional register-ir feature\neager lowering + immutable specialized blocks" as plans
    builder --> encoder
    builder --> legacy : explicit source construction context
    legacy --> artifact : supplied body preservation
    encoder --> artifact
    artifact --> validation
    validation --> prepared : private validated token
    prepared --> plans : charge preparation before allocation
    note bottom of prepared
        Runtime::from_bytes consumes source-free artifact bytes.
        Ordinary byte preparation transfers validated owned tables;
        borrowed/artifact-retaining inputs clone at the shared materializer boundary.
        No serialization of current PLC values or lazy materialization occurs in RUN.
        Types, imports, instruction targets, construction demand and profile limits
        remain validated on every admitted composition, including MCU targets.
        Optional register plans alter representation, never the PLC function set.
        Portable POU indexes hold sparse IDs and private payload ordinals;
        payload capacity and index storage are charged before materialization.
        Read-only lookup/iteration preserves ID order; hosted map APIs stay intact.
        One execution-frame registry owns reserved/active membership, POU owners
        and suspended locals; no parallel live-ID or owner collections.
        Tail activation lookup/retirement is direct; non-tail cleanup stays checked.
        Per-POU frame plans retain admitted ranges for all initialization phases,
        including empty phases and the after-restart static selection.
        Declaration owner ranges are prepared once; checked identities preserve
        sparse POU IDs and physical slot holes without max-ID-sized allocation.
        Typed construction borrows admitted field/variant metadata across callbacks;
        owned result dimensions retain charged copies. Marker reads search each
        required directory once, admitting work before each lookup and row access.
        Owner/root ordinal tables are bounded by admitted record counts;
        POU identities fold into full-key-checked buckets; collisions use charged binary fallback. Active type-operation masks
        replace repeated membership scans; the type stack still owns depth/unwind.
        Marker search plans reserve both destinations before storage publication;
        exclusive publication guards retain checked positions without repeated searches.
    end note
}

package "One state authority" as ownershipPkg #LightGreen {
    component "OwnedRuntimeState<S> / RuntimeState\n(core/engine/owned.rs + api.rs)" as owner
    component "EngineData\nsole VariableStorage and process images\ntasks, construction, fault and execution resources" as data
    component "EngineState\nprivate borrowed operation context\nExecutionContext / RegisterContext" as context
    component "Host Runtime facade\n(runtime/installed.rs)\nread-only metadata + mutable host adapters" as host
    component "runtime-only std facade\n(runtime_only.rs)\nclock/deadline services; no HIR/compiler/product graph" as minimal
    component "ExecutionServices\nplatform clocks, deadlines, observers\ndefault no-op adapters where applicable" as services
    prepared --> owner : admitted instantiation
    owner *-- data
    owner --> context : temporary exclusive entry
    context --> data : checked policy and accounting
    host *-- owner
    minimal *-- owner
    context --> services
    note bottom of owner
        Public facades do not implement raw mutable execution context traits.
        Checked writes normalize against admitted types and commit only after
        range, constant, lifetime, binding and deadline checks succeed.
        Invalid engineering requests do not themselves latch a PLC fault.
        Shared entry state owns one cumulative work/deadline allowance.
    end note
}

package "Shared execution choices" as executionPkg #LightCyan {
    component "EngineState::execute_pou\nprepared POU and parameter-presence bindings" as entry
    component "Core register executor\nexecute_register_program\nprepared lowering / tier-1 selection" as register
    component "Core stack dispatcher\nexecute_pou_stack_with_locals\none opcode loop; no-register calls stay in-loop" as stack
    component "VM activation pump\nregister-ir mixed stack/register continuations\nsaved caller cursor + leased register scratch" as pump
    component "call preparation/completion\nframes, parameters, edges, OUT/IN_OUT journal" as calls
    component "Reference operations\nborrowed checks; materialized character fallback\ndynamic field/index and reference-attempt policy" as references
    component "Core numerics / full standard library\nlocked libm + conversions + timers/counters/FBs" as library
    component "ExecutionBudget\noriginal bytecode instruction costs + bounded helper work\nphysical deadline boundary/stride checks" as allowance
    context --> entry
    entry --> stack : no register-ir feature
    entry --> pump : register-ir feature
    pump --> register : eligible POU scratch available
    pump --> stack : unprepared / unsupported / recursive scratch occupied
    plans --> register
    register --> pump : user POU call that can nest yields destination and cursor
    stack --> pump : register-ir stack activation yields cursor
    pump --> calls : common return validation and output copyback
    register --> calls : library call, or leaf POU call run in place
    stack --> calls : immediate library call
    register --> references
    stack --> references
    calls --> library
    references --> context
    calls --> context
    register --> allowance
    stack --> allowance
    pump --> allowance
    calls --> allowance
    library --> allowance
    note bottom of calls
        Uniquely owned expression arguments move into function/method bindings;
        borrowed inputs, constants and storage reads retain copy admission.
        Owned bound locals move into selected callee scratch; declining optimized
        execution preserves the original payload for the shared stack fallback.
        A single output snapshot enters the active rollback journal directly,
        after resolution and growth/copy admission; commit checks remain.
        Frame declarations publish local values without persistent instance markers.
        Edge qualification reuses the installed POU ID; compatibility callers
        retain name resolution and the same edge transaction.
    end note
    note bottom of register
        Independent eligible-POU scratch, including frame locals and parameter-presence
        payloads, is reserved before RUN and recycled after success or fault. Returned
        locals stay leased through caller copyback; recursive re-entry uses stack fallback
        until the caller returns that payload.
        Borrowed entry payloads retain separately charged, fallible copies.
        Nested register re-entry falls back before starting a frame or resetting fuel.
        A call to a prepared POU that makes no user call (a leaf) runs to completion
        inside the caller's call instruction, with the pump's checks, charges,
        completion and failure cleanup; debugging and occupied scratch use the pump.
        Hot thresholds and fixed prepared LRU select already compiled blocks.
        Profile reset preserves selection; tier reset clears selection/hits,
        retains immutable prepared code and requires warmup again.
        No std timing/thread-local state or first-use compilation lives in plans.
    end note
    note bottom of pump
        Stack callers resume from their saved PC and operand scope. Register callers
        resume within the selected block at the instruction after the yielded call;
        block selection, statement hooks, read counts and instruction charges are not replayed.
        The leased per-POU register buffer stays unavailable until completion or unwind.
        One shared stack-frame/operand buffer serves stack fallbacks across the activation tree.
    end note
    note bottom of stack
        Without register-ir, a native user call pushes a child frame and saves
        a cursor continuation inside this same opcode loop. Return runs the
        shared PreparedCall completion path and restores the parent cursor.
        HIR optimized hooks retain their existing synchronous admission order.
    end note
}

package "Common cooperative cycle" as cyclePkg #LightBlue {
    component "Core cycle controller\nready-task scratch; nominal deadlines;\npriority/due/index ordering; background programs" as cycle
    component "CycleHooks / CycleAccess\ncallback-scoped checked host ports\noptional read-only program observations" as hooks
    card "CycleStart\npending engineering writes + runtime events" as start
    card "BeforeInputSample\nphysical image acquisition / debug I/O / forces" as input
    card "Mapped-input sample\nAfterInputSample: ADS / OPC UA cache copyback" as latched
    card "Ready tasks + background\nshared POU entries" as work
    card "BeforeOutputSample\nretain save" as retain
    card "Mapped Q/M sample\nAfterOutputSample: forces, protocol capture, inspection" as sample
    card "Deadline check + publish_outputs\nphysical driver submission" as submit
    card "Commit / final observations\nthen hosted telemetry and cycle metrics" as outcome
    owner --> cycle
    host --> hooks : adapters borrowed for one cycle
    cycle --> hooks
    cycle --> start
    start --> input
    input --> latched
    latched --> work
    work --> retain
    retain --> sample
    sample --> submit
    submit --> outcome
    work --> entry
    note bottom of submit
        Pre-submission or driver failure restores touched flat-Q windows.
        M and hierarchical effects retain the existing hosted rollback domain.
        Successful driver submission commits Q; subsequent deadline/telemetry
        faults cannot undo already accepted physical output work.
        Ordinary no-hook MCU execution retains its existing publication path.
    end note
}

package "Checked lifecycle and observation" as lifecyclePkg #Lavender {
    component "ResourceReconfiguration\nstaged images/tasks + exclusive commit\nno initializer replay or storage clone" as resource
    component "Prepared replacement / restart\nisolated construction + retain compatibility\natomic candidate publication" as replacement
    component "Safe outputs\nseparate checked owner operation\nall drivers attempted; owning fault retained" as safe
    component "StatementFrame\ncurrent + suspended invocation views" as frames
    component "HostedExecutionServices / RuntimeMetadata\nsource lookup and detached DebugSnapshot" as debugger
    component "DAP expression scratch\nseparate authoring types and copied inspection values" as scratch
    host --> resource : resource / direct / MQTT binding updates
    resource --> owner : preserve identities, live values, debug/IR/fault state
    host --> replacement : code / schema / warm restart
    replacement --> owner : commit fully validated candidate
    host --> safe : STOP / watchdog / fault policy
    safe --> hooks : authoritative images; deadline suspension for safety delivery
    context --> frames : observer borrow only after construction
    frames --> debugger
    services --> debugger
    debugger --> scratch
    scratch --> host : checked writes / queued next-scan requests
    note bottom of replacement
        Failed candidate preparation leaves the installed generation unchanged.
        Restart construction has no active debugger observations.
        Resource-only binding changes preserve task timing; explicit task changes
        reseed registration timing/SINGLE while thread identity history is retained.
    end note
    note bottom of debugger
        Detached snapshots retain real local-slot offsets and ancestor identities.
        Compiler scratch names are hidden from user-facing rows.
        Snapshot edits never mutate live locals or executable types.
        Retired queued frame destinations produce WriteRejected at the next scan.
    end note
}

package "MCU compositions and evidence boundary" as mcuPkg #Wheat {
    artifact "Independent application flash\nTRSTB002 main / numeric / GPIO artifacts\nsame bytes on both boards" as bundle
    component "trust-board-fixture\nM2E runner + records + bundle decode\nmeasured heap / 16 KiB stack window" as fixture
    component "firmware/trust-nucleo-f401re\nF401 composition: identity, reset cookie, supervisor" as firmware
    component "trust-platform-stm32f4::Board\nTIM2 / PC13 / PA5 / USART2 / IWDG" as board
    node "NUCLEO-F401RE" as device
    component "firmware/trust-esp32c6-reference\nC6 composition: identity, reset cookie, supervisor" as c6firmware
    component "trust-platform-esp32::Board\nSYSTIMER / GPIO9 / GPIO18 / USB-Serial-JTAG / MWDT0" as c6board
    node "ESP32-C6-DevKitC-1" as c6device
    artifact --> bundle : stopped installation
    bundle --> firmware : sector 1
    bundle --> c6firmware : stbc partition
    firmware --> fixture
    c6firmware --> fixture
    fixture --> prepared : same on-device admission
    fixture --> owner : borrowed facade; optional register tier omitted
    firmware --> board
    c6firmware --> c6board
    board --> device
    c6board --> c6device
    note bottom of fixture
        Core depends on no board adapter and not on the fixture; the adapters depend on no
        workspace crate; firmware has no host runtime dependency.
        F401: vectors and immutable firmware data share sector 0; application sector 1,
        checkpoint reserves 2/3 and upper code sectors 4-7 stay independently erasable.
        C6: factory application, 16 KiB stbc partition, reserved ckpt_a / ckpt_b;
        no flash write or erase during RUN.
        All PLC functions and overflow checks remain present.
        Source/rendered diagrams do not establish flash/RAM fit, timing or hardware proof.
    end note
}

package "Separate helper / historical boundary" as helpersPkg #Gainsboro {
    component "Compiler const folding / declaration lowering\nnon-executable source authoring" as authoringHelpers
    component "Private cfg(test) LegacyRuntimeFixture\nold host core/cycle/VM and 1.1 assertion corpus" as historical
    component "Stable error codes\nBytecodeError / VmTrap / RuntimeError" as errors
    authoringHelpers --> builder
    historical ..> legacy : test fixture context only
    validation --> errors
    stack --> errors
    register --> errors
    context --> errors
    note bottom of historical
        Historical executors and HIR local-initializer helpers are test-only.
        Product cycles, explicit POU entries and restarts use the same core engine.
        Diagnostic text is separate from stable machine error identities.
    end note
}

legend right
    Architecture source view, not a compilation or release/hardware acceptance record.
    Full and runtime-only hosts share execution; selected service graphs differ.
    No production Expr evaluator, lazy VM build or second mutable PLC authority.
end legend
@enduml
