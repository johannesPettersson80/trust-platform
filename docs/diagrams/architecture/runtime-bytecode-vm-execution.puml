@startuml runtime-bytecode-vm-execution
!theme plain
allowmixing
skinparam backgroundColor #FEFEFE
skinparam componentStyle uml2
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 35

title truST Runtime: VM Execution and Helper Evaluation

package "Opt-in STBC 2.0 authoring (A3)" as sourceFreeAuthoring {
    component "CompileSession::build_bytecode_module_for_version" as sourceFreeApi
    component "LoweredApplication\noriginal declarations and Exprs\nno startup evaluation" as loweredApplication
    component "bytecode::encoder::construction\nreachable templates, actions, shared recipes\nI/O, task and access bindings" as constructionEncoder
    artifact "STBC 2.0\nTYPE_TABLE + construction metadata\nordinary bytecode initializer bodies" as sourceFreeArtifact
    sourceFreeApi --> loweredApplication
    loweredApplication --> constructionEncoder
    constructionEncoder --> sourceFreeArtifact
    note bottom of sourceFreeArtifact
        Portable format and staging-write validation; no HIR in the artifact.
        Initial and after-restart static contexts remain distinct.
        Legacy Runtime import stays 1.x; PreparedModule admits 2.0.
        RuntimeState executes typed helpers and lifetime/visibility checks.
        Prepared indexes and one immutable native registry are built at admission.
        Mutable state separates lifetimes, construction, images and resource accounting.
        Stores use indexed declarations; output groups journal destination slots only.
        I/O stages bound values; publication work follows bindings, not image size.
        One execution allowance covers instructions and helper work across nested calls.
        Physical deadlines are polled at boundaries and a bounded work stride.
        Borrowed reference checks do not allocate reference paths.
    end note
}


component "trust-runtime-core::numeric::math\nlocked libm primitives\nshared by operators and hosted stdlib" as coreMath
note right of coreMath
    A1 preserves promotion, narrowing and fault policy.
    Core value storage uses a portable ordered-map alias.
    The shared core dispatcher serves hosted and source-free adapters.
end note

package "Production Cycle Entry" as entryPkg #LightBlue {
    component "Runtime::execute_cycle()\n(runtime/cycle.rs)" as cycle
    component "execute_task() /\nexecute_background_programs()" as taskDispatch
    component "ensure_vm_module_loaded() /\nbuild_vm_module()\n(runtime/cycle.rs)" as ensureVm

    cycle --> taskDispatch
    taskDispatch --> ensureVm : execute_program_by_name / execute_function_block_ref
}

package "Lazy VM Module Materialization" as modulePkg #LightYellow {
    artifact "BytecodeModule::from_runtime*\n(runtime -> STBC sections)" as bytecodeBuild
    component "trust-runtime-core::bytecode\nBytecodeModule::decode() + validated()\n(shared decode + bounded analysis)" as bytecodeGuard
    component "VmModule::from_validated()\n(trust-runtime-core/vm/module.rs)" as vmModule
    component "VmModule cached on Runtime\nstrings, refs, consts, pou tables,\nnative symbol specs, debug map" as vmModuleState

    ensureVm --> bytecodeBuild : when vm_module missing
    bytecodeBuild --> bytecodeGuard
    bytecodeGuard --> vmModule : immutable ValidatedBytecode token
    note left of bytecodeGuard
        Core owns container, byte serialization, CRC and metadata.
        Host compatibility view borrows sections without cloning.
        Compiler/HIR lowering remains hosted.
        Source-free executable state is owned by core RuntimeState.
        Real modules share compact decoded instructions and stack effects.
        Module context builds sorted lookup indexes once; ranges are intervals.
        Block-entry stack states use fallible bounded scratch storage.
        All POUs and metadata share one analysis work budget.
    end note
    vmModule --> vmModuleState
}

note right of vmModuleState
    Native-call symbol metadata is
    prepared when the VmModule is built.
    CALL_NATIVE does not need to split
    raw symbol strings every cycle.

    `SIZEOF(...)` operands are resolved to
    static types before ST bytecode emit.
    Production codegen emits `SIZEOF_TYPE`
    only; legacy `SIZEOF_VALUE` exists for
    compatibility / negative-path coverage.
end note

package "Program / FB Execution Inside VM" as vmExecPkg #LightCyan {
    component "vm::dispatch::execute_program_by_name() /\nexecute_function_block_ref()" as vmEntry
    component "try_execute_pou_with_register_ir_with_locals()\n(register path + lowering cache)" as regTry
    component "execute_register_program()\n(register executor + tier1)" as regExec
    component "trust-runtime-core::vm::dispatch\nexecute_pou_stack_with_locals()" as stackExec
    component "instruction budget\n(original bytecode costs, shared by nested calls)" as instructionBudget
    component "debug_map.rs\n(pc -> source / symbol lookup)" as debugMap

    vmModuleState --> vmEntry
    vmEntry --> regTry
    regTry --> regExec : eligible + not stepping
    regTry --> stackExec : debug mode / lowering error / unsupported shape / fallback
    regExec --> instructionBudget : fused instruction cost
    stackExec --> instructionBudget : one original instruction
    regExec --> debugMap
    stackExec --> debugMap
    regExec --> coreMath : shared arithmetic
    stackExec --> coreMath : shared arithmetic
}

note right of regTry
    RegisterLoweringCacheState and the
    tier1 specialized executor live here.

    Debug stepping intentionally keeps
    stack-bytecode execution as the
    single source of truth.
end note

note right of instructionBudget
    Stack, register, and tier-1 execution
    charge the same original bytecode count.
    Nested POU/native calls receive the caller's
    remaining budget; exhaustion maps to the
    existing execution-timeout category.
end note

package "Shared Core Runtime Bridges" as bridgePkg #Lavender {
    component "call/mod.rs + continuation.rs\nshared call preparation/completion\nbinding + edge/output restoration" as callBridge
    component "dispatch_refs.rs\nref / deref / dynamic field-index bridge" as refBridge
    component "reference_attempt.rs\n?= live type/interface compatibility" as attemptBridge
    component "frames.rs + stack.rs\nframe stack + operand stacks\n(pooled execution buffers)" as vmStacks
    component "VariableStorage\n(trust-runtime-core/memory.rs)" as storage

    regExec --> callBridge : CALL_NATIVE
    stackExec --> callBridge : CALL_NATIVE
    regExec --> refBridge : LoadRef / StoreRef / RefField / RefIndex / LoadDynamic
    stackExec --> refBridge : ref opcodes
    stackExec --> attemptBridge : REFERENCE_ATTEMPT 0x64
    vmEntry --> vmStacks
    callBridge --> vmStacks : owned call continuation
    stackExec --> vmStacks : push / finish / unwind in one loop
    callBridge --> storage : direct field bind / instance reads-writes
    refBridge --> storage : ValueRef-based reads-writes
    attemptBridge --> refBridge : live ValueRef type
    attemptBridge --> storage : live instance type
}

note bottom of callBridge
    Current performance-sensitive boundary:
    - VM native-call argument marshaling
    - FUNCTION_BLOCK parameter binding
    - OUT / IN_OUT copy-back
    - iterative stack-VM calls
    - synchronous hosted optimized adapter
end note

note bottom of refBridge
    Current performance-sensitive boundary:
    - ValueRef materialization
    - dynamic field/index traversal
    - instance-field resolution
    - storage read/write cloning pressure
end note

package "Source-free execution (trust-runtime-core)" as portableEngine #LightGreen {
    component "PreparedModule\nvalidated artifact + profile admission\nimmutable VM and construction metadata" as prepared
    component "RuntimeState\nowned storage + process images\nnominal-deadline tasks + latched fault" as portableState
    component "initialization/\nTYPE_TABLE values and STBC initializer bodies\nstaged writes + recursive lifetime checks" as portableInit
    interface "ExecutionServices\nphysical deadline, UTC, retain persistence" as services
    component "Shared stdlib/\nscalar functions + storage-backed timers/FBs" as portableStdlib
    sourceFreeArtifact --> prepared
    prepared --> bytecodeGuard
    prepared --> portableState : instantiate
    portableState --> portableInit : construction / frame entry / restart
    portableInit --> stackExec : same dispatcher and shared fuel
    portableState --> stackExec : scheduled + background POUs
    portableState --> storage
    portableState --> services
    callBridge --> portableStdlib
    portableState --> instructionBudget
    note bottom of portableState
        Single-owner execution; input sample, due tasks, background,
        retain checkpoint, then output publication.
        A failed restart never publishes its candidate state.
        This diagram is architecture, not hardware qualification.
    end note
}

package "Scope B composition: NUCLEO-F401RE" as f401Composition #Wheat {
    artifact "Independent flash sector 1\nTRSTB002 bundle: A4 main + numeric + GPIO\nlengths and CRCs checked before preparation" as f401Bundle
    component "firmware/trust-nucleo-f401re\nsingle-owner runner + supervisor\nbounded heap and MSP instrumentation\nL2: code sectors 4–7; checkpoint reserves 2/3" as f401Runner
    component "trust-platform-stm32f4::Board\nTIM2 monotonic, PC13 sample, PA5 publication\nUSART2, IWDG, reset cookie, identity" as f401Board
    artifact "Bounded UART trace\nxtask portability verify / inspect\nlogical oracle versus physical observations" as f401Evidence
    node "STM32F401RE / MB1136\nactual GPIO IDR, hardware time and reset flags" as f401Device

    sourceFreeArtifact --> f401Bundle : stopped bench installation
    f401Bundle --> f401Runner : independently installed bytes
    f401Runner --> prepared : source-free admission; no compiler/HIR
    f401Runner --> portableState : sample image, execute cycle, read committed output
    f401Runner ..> services : physical deadline adapter; no UTC or retain store
    f401Runner --> f401Board : publish or safe-off; feed only after accepted work
    f401Board --> f401Runner : physical input / IDR readback / timer / reset evidence
    f401Board --> f401Device : owned HAL/PAC peripherals
    f401Runner --> f401Evidence
    note bottom of f401Runner
        Separate firmware workspace composes the same core, not another VM.
        Core never imports the board adapter; platform has no runtime dependency.
        SysTick records IRQ activity only; it never executes PLC work.
        Injected input-image cases remain distinct from physical PC13 samples.
        72 KiB heap and 16 KiB MSP are bring-up reservations, not fit results.
        B-R1 keeps all IEC operations and admission checks; shared compact CRC,
        byte-input preparation without re-encoding, and static default-library metadata.
        Source/diagrams do not establish hardware, timing or bounded-RUN acceptance.
    end note
}

package "Stable Machine Error Boundary" as errorPkg #HoneyDew {
    component "StableErrorCode\n(trust-runtime-core/error_code.rs)" as stableCode
    component "BytecodeError::stable_code()\n(decoder + validator category)" as bytecodeCode
    component "VmTrap::stable_code() +\nRuntimeError::stable_code()" as runtimeCode
    component "typed HMI write admission failure\n(type / string / subrange / non-finite)" as hmiWriteCode
    artifact "ControlResponse.error_code\n(stable lower-snake-case identifier)" as controlErrorCode

    bytecodeGuard --> bytecodeCode : rejected candidate
    bytecodeCode --> stableCode
    vmEntry --> runtimeCode : execution trap
    runtimeCode --> stableCode
    hmiWriteCode --> stableCode
    hmiWriteCode --> controlErrorCode : rejected before queueing
}

note right of errorPkg
    Stable identifiers are selected by
    exhaustive enum matches. Diagnostic
    text remains separate and is never
    parsed to recover a machine code.

    BytecodeError -> RuntimeError and
    VmTrap -> RuntimeError preserve the
    selected bytecode_* / vm_* code.
end note

package "Helper Evaluation\n(non-cycle helper flows only)" as helperPkg #MistyRose {
    component "Runtime::evaluate_expression()\n(runtime/core/evaluation.rs)" as runtimeEval
    component "helper_eval::const_expr\ncompile-time const folding" as constEval
    component "helper_eval::storage_expr\ndebug/config/init reads" as storageEval
    component "helper_eval::storage_lvalue\ndebug pending writes" as storageWrite
    component "harness::initializer\nstartup/default materialization" as initService
    component "runtime/vm/local_init.rs\nlegacy 1.x HIR local/static initializer plans" as vmLocalInit
    component "DebugRuntimeContext\n(debug/hook.rs)" as debugCtx

    runtimeEval --> storageEval
    initService --> storageEval : evaluate default expressions
    vmEntry --> vmLocalInit : first local/static materialization
    vmLocalInit --> initService : default + aggregate values
    debugCtx --> storageEval
    cycle --> storageWrite : pending debug writes
    constEval --> storage
    storageEval --> storage
    initService --> storage : materialize globals/instances
    storageWrite --> storage
}

note right of helperPkg
    These helpers exist for bounded
    const/debug/config/init flows only.
    Startup materialization is
    orchestrated by harness::initializer.
    VM local/static initialization
    consumes the same default/materialization
    service through local init plans.

    Scheduled task/program execution
    does not pass through EvalContext or
    an interpreter backend anymore.
end note

legend right
    **What this diagram clarifies**
    1. Production task/program execution goes directly to the VM path.
    2. There is no production backend-dispatch seam or interpreter backend.
    3. The VM hot path is the combination of:
       - register_ir.rs
       - dispatch.rs
       - call/mod.rs + call/continuation.rs
       - dispatch_refs.rs
       - memory.rs
    4. `helper_eval` handles const/debug/config/init helpers only.
    5. Bytecode resource limits are checked before executable materialization.
    6. Stable bytecode, VM, runtime, and HMI error identifiers do not depend on diagnostic text.
    7. Remaining evaluator internals are test-only and are not part of the runtime scan-loop architecture.
end legend

note as FootprintDetails
Structured admission diagnostics retain reasons/context;
text rendering is deferred. Shared compact keys and sorting
preserve identities, ordering and the uniform PLC function set.
F401 sector 0 contains vectors and bounded immutable firmware data;
application/checkpoint erase sectors remain independent.
Upper-region headroom and total flash use are reported separately.
Live frames use sorted identities; portable instances use compact live entries.
Existing variable hash indexes replace duplicate portable name caches.
Sorted destination journals preserve alias rollback; charged retirement completes
cleanup even when execution fuel is exhausted.
Bulk input journals sort/deduplicate physical slots before snapshotting.
Observed deadline expiry stays latched through cleanup until operation reset.
Compiled PLC calls use explicit VM continuations with isolated operand floors;
shared prepare/complete helpers preserve bindings, edges and error cleanup.
Firmware fixture phases keep independent native frames and stop on failed stack margin.
Prepared-module control owners live in the measured bring-up heap before instantiation.
Warm/cold restart carries process images into staged state before initialization;
ordered configuration actions win at selected targets, while other values survive.
Failed replacement leaves the installed state and images intact.
end note
@enduml
