@startuml runtime-native-execution
!theme plain
allowmixing
skinparam backgroundColor #FEFEFE
skinparam componentStyle uml2
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 35

title truST Native Execution (specification 44): Build, Image, the Chip's and the Computer's Kernel

package "Engineering computer: trust-runtime build" as buildPkg #LightYellow {
    component "trust-hir\nrecorded types and resolved symbols\n(FileAnalysis)" as hir
    component "host/native/front + model + classes\nlayout of areas, instances, tasks,\nbindings, class ids, starting memory" as model
    component "host/native/lower + emit + dispatch\none Rust crate per program; calls bound\nby class id; no unsafe in generated code" as generator
    component "host/native/recursion\ncall graph of the generated crate;\na call into its own cycle takes one\nfrom Cx.depth (§6.4)" as recursion
    component "pinned rustc + rust-lld\n(toolchain bundle, §4.6)\nstatic PIE, no relocations" as toolchain
    component "host/native/bundle (§4.6)\nToolchain::find: TRUST_TOOLCHAIN or the bundle\nin truST's data folder, installed on the first\nbuild (release download or file), checked\nagainst SHA256SUMS and its manifest" as bundle
    bundle --> toolchain : find / find_or_install
    component "trust-plc-lib\narithmetic, conversion, mathematics,\nbits, text, dates and times,\ntimers, counters, edges, bistables" as library
    component "trust-plc-abi\nCx, areas, faults, references,\nclass ids; module side" as abiModule
    component "trust-plc-mem\nmemcpy, memset, memcmp\nfor computer modules" as memModule
    component "trust-lsp.toml [build] debug\n(host/native/settings.rs; true when absent):\na debug image with statement hooks\nor a release image without them (§13.2)" as buildSetting
    artifact "program.<triple>.tpi (TRSTI001)\nCODE, RODATA, INIT, tables,\nmemory figure with the call level,\nheader flag release, sources hash,\nprogram library hash, SIGN last" as image
    component "host/native/signing (§5.11)\nthe project's [signing] key or the user's\nsigning-key.pem (truST configuration folder);\nfills SIGN in place, before the record" as signing
    artifact "deployment-record.<triple>.bin\nversion 44.1, tasks, process image,\nruntime.toml + io.toml" as record
    component "trust-dev test\nTEST_PROGRAMs as instances without a task;\neach test: cold start, run_instance once" as testRunner
    hir --> model
    model --> generator
    generator --> recursion : call graph
    recursion --> generator : again, with the recursive calls
    buildSetting ..> generator
    buildSetting --> testRunner : tests the kind of image the project builds
    generator --> toolchain
    library --> toolchain
    abiModule --> toolchain
    memModule --> toolchain
    toolchain --> image
    signing --> image : sign (trust-runtime build,\ntrust-dev test --device)
    image --> record : DeploymentRecord::for_image
    testRunner --> model : build_with_tests
    testRunner ..> image : runs on this computer's kernel
}

package "Container and program store (specification 34 §5.1)" as storePkg #LightGreen {
    artifact "TRSTA002 container\nentry kind 3 = image at a 64-byte boundary,\nkind 2 = record" as container
    component "installation::admit_sequenced\nkind and record version agree;\ndescriptor names 44.1" as admission
    component "loading::install::check\nkernel checks of §10.2 (native::admission:\nlibrary, signature against the trusted keys,\ntables, bindings, memory)" as installCheck
    image --> container : xtask pack-project / encode_image
    record --> container
    container --> admission
    admission --> installCheck : program.install
}

package "ESP32-C6 firmware (the STM32U5A9 runs CODE in place from flash)" as chipPkg #LightCyan {
    component "Runner (trust-runtime-services)\nfixed cycle grid (spec 10 §4.3),\nlink, faults, watchdog, metrics" as runner
    component "CompiledLoader\n(trust-platform-esp32)\nadmit, place module, claim lines" as loader
    component "ProgramCode\n192 KiB program region of the heap (.trust_code),\nexecutable: module copies at the top, uploads\nat the bottom; flash window as fallback" as codeRegion
    component "CompiledCycle\nread inputs, scan, deadline,\nsnapshot, drive outputs" as cycle
    component "NativeProgram (trust-runtime-core::native)\nareas, task readiness, bindings to the flat\nimages and the hierarchical image's slots,\nenumeration inputs checked, fault mapping" as kernel
    component "native::retain\ncapture and restore through the\nretain map and the type table" as retainMap
    component "RetainStore\nshared capture, checkpoint log\nin flash (STRN v3 payload)" as retainStore
    component "module entry points\nextern C fn(*mut Cx) -> u32" as module
    component "KERNEL_FUNCTIONS\nstop, debug_write, read_real, wall_clock\n(the runtime's reader of reals; the\nplatform's wall clock for CURRENT_DT)" as kernelFunctions
    admission --> loader : boot / restart (Booted, format Image)
    loader --> codeRegion : copy CODE + RODATA, fence.i
    loader --> cycle : CompiledCycle::start (cold),\nwith_retain, warm restart\nfrom the checkpoint
    runner --> cycle : run_scan(now, deadline, observer)
    cycle --> kernel : scan(now, task hooks)
    kernel --> module : Entry::call(Cx)
    module ..> kernelFunctions : Cx::api (interface version 5)
    codeRegion ..> module : executes
    cycle --> retainStore : capture at the output sample,\nstep between scans, save at stop
    retainStore --> kernel : capture_retain /\nwarm_start_from
    kernel --> retainMap
}

package "Computer: trust-runtime run (specification 44 §8.8)" as hostPkg #Lavender {
    artifact "program.tpi + deployment-record.bin\n(trust-runtime build, program.install)" as hostImage
    artifact "device.toml [signing] trusted_keys\n(truST configuration folder;\nnative::runtime_device)" as hostTrust
    component "ResourceRunner, scan thread\n(CompiledRuntime),\ncycle grid, watchdog, faults, commands" as hostRunner
    component "CompiledRuntime\nHostIo (io.toml drivers), RetainManager\n(retain file), metrics, events, snapshot" as hostRuntime
    component "CompiledDebugger\nChipDebug under a lock; the scan thread\nholds, control threads answer" as hostDebugger
    component "control server threads\ndebug::requests::answer, io.read,\nLive Values queues (DebugControl)" as hostControl
    component "HMI, ADS and OPC UA servers, historian\nread the published CompiledState\nthrough the symbol table" as hostServices
    component "ADS and OPC UA clients, MQTT tags,\nOpenOT telemetry: variables by name;\nsamples after the inputs, outputs and\nproducers after the scan" as hostClients
    hostImage --> hostRuntime : CompiledRuntime::load_deployed\n(AdmittedImage kept, module mmapped)
    hostTrust ..> hostRuntime : admits at load and\nat each online change
    hostRunner --> hostRuntime : execute_cycle / restart /\nonline change / step
    hostRuntime --> cycle : the same CompiledCycle,\nhost ports
    hostRuntime --> hostDebugger : hold port, published state
    hostControl --> hostDebugger : debug operations
    hostRuntime --> hostServices : DebugSnapshot.compiled
    hostRuntime --> hostClients : on_compiled_access
}

note bottom of chipPkg
    The observer sees the cycle start, input sample, task overruns, starts and ends, each
    program body's start and end, output sample and cycle end (CycleHooks::on_compiled_phase,
    ScanHooks::program_started/finished): status, tasks.stats, program-call profiles,
    io.read and the allocation count report the compiled scans. The retained values are
    checkpointed in the format the deleted bytecode engine wrote, so its checkpoints restore (M2). Online change (the module runs in its image in
    the program region), breakpoints, stepping and Live Values (M3) are served on the chip and
    on the computer by the same cycle and debugger code.
end note
@enduml
