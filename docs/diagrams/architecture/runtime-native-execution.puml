@startuml runtime-native-execution
!theme plain
allowmixing
skinparam backgroundColor #FEFEFE
skinparam componentStyle uml2
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 35

title truST Native Execution (specification 44): Build, Image and the Chip's Kernel

package "Engineering computer: trust-runtime build --target" as buildPkg #LightYellow {
    component "trust-hir\nrecorded types and resolved symbols\n(FileAnalysis)" as hir
    component "host/native/front + model + classes\nlayout of areas, instances, tasks,\nbindings, class ids, starting memory" as model
    component "host/native/lower + emit + dispatch\none Rust crate per program; calls bound\nby class id; no unsafe in generated code" as generator
    component "host/native/recursion\ncall graph of the generated crate;\na call into its own cycle takes one\nfrom Cx.depth (§6.4)" as recursion
    component "pinned rustc + rust-lld\n(toolchain bundle, §4.6)\nstatic PIE, no relocations" as toolchain
    component "trust-plc-lib\narithmetic, conversion, mathematics,\nbits, text, dates and times,\ntimers, counters, edges, bistables" as library
    component "trust-plc-abi\nCx, areas, faults, references,\nclass ids; module side" as abiModule
    component "trust-plc-mem\nmemcpy, memset, memcmp\nfor computer modules" as memModule
    component "trust-lsp.toml [build] debug\n(host/native/settings.rs; true when absent):\na debug image with statement hooks\nor a release image without them (§13.2)" as buildSetting
    artifact "program.<triple>.tpi (TRSTI001)\nCODE, RODATA, INIT, tables,\nmemory figure with the call level,\nheader flag release" as image
    artifact "deployment-record.<triple>.bin\nversion 44.1, tasks, process image,\nruntime.toml + io.toml" as record
    component "trust-dev test --execution-backend native\nTEST_PROGRAMs as instances without a task;\neach test: cold start, run_instance once" as testRunner
    hir --> model
    model --> generator
    generator --> recursion : call graph
    recursion --> generator : again, with the recursive calls
    buildSetting ..> generator
    buildSetting --> testRunner : tests the kind of image the project builds
    generator --> toolchain
    library --> toolchain
    abiModule --> toolchain
    memModule --> toolchain
    toolchain --> image
    image --> record : DeploymentRecord::for_image
    testRunner --> model : build_with_tests
    testRunner ..> image : runs on this computer's kernel
}

package "Container and program store (specification 34 §5.1)" as storePkg #LightGreen {
    artifact "TRSTA002 container\nentry kind 3 = image at a 64-byte boundary,\nkind 2 = record" as container
    component "installation::admit_sequenced\nkind and record version agree;\ndescriptor names 44.1" as admission
    component "loading::install::check\nkernel checks of §10.2 in place\nof the STBC dry run" as installCheck
    image --> container : xtask pack-project / encode_image
    record --> container
    container --> admission
    admission --> installCheck : program.install
}

package "ESP32-C6 firmware --features native" as chipPkg #LightCyan {
    component "Runner (trust-runtime-services)\nfixed cycle grid (spec 10 §4.3),\nlink, faults, watchdog, metrics" as runner
    component "CompiledLoader\n(trust-platform-esp32)\nadmit, place module, claim lines" as loader
    component "ProgramCode\n128 KiB .trust_code region in RAM,\nexecutable; flash window as fallback" as codeRegion
    component "CompiledCycle\nread inputs, scan, deadline,\nsnapshot, drive outputs" as cycle
    component "NativeProgram (trust-runtime-core::native)\nareas, task readiness,\nbindings, fault mapping" as kernel
    component "native::retain\ncapture and restore through the\nretain map and the type table" as retainMap
    component "RetainStore\nshared capture, checkpoint log\nin flash (STRN v3 payload)" as retainStore
    component "module entry points\nextern C fn(*mut Cx) -> u32" as module
    component "KERNEL_FUNCTIONS\nstop, debug_write, read_real\n(the runtime's reader of reals)" as kernelFunctions
    admission --> loader : boot / restart (Booted, format Image)
    loader --> codeRegion : copy CODE + RODATA, fence.i
    loader --> cycle : CompiledCycle::start (cold),\nwith_retain, warm restart\nfrom the checkpoint
    runner --> cycle : run_scan(now, deadline, observer)
    cycle --> kernel : scan(now, task hooks)
    kernel --> module : Entry::call(Cx)
    module ..> kernelFunctions : Cx::api (interface version 3)
    codeRegion ..> module : executes
    cycle --> retainStore : capture at the output sample,\nstep between scans, save at stop
    retainStore --> kernel : capture_retain /\nwarm_start_from
    kernel --> retainMap
}

note bottom of chipPkg
    The observer sees the cycle start, input sample, task overruns, starts and ends,
    output sample and cycle end (CycleHooks::on_compiled_phase): status, tasks.stats,
    io.read and the allocation count work as for STBC. The retained values are checkpointed
    in the format the interpreter writes (M2). Online change, breakpoints and Live Values
    writes (M3) are not served yet.
end note
@enduml
