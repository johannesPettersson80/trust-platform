@startuml step-over-sequence
!theme plain
skinparam sequenceMessageAlign center

title Step Over Request Flow

actor "VS Code" as vscode
participant "DebugAdapter\ncore.rs" as adapter
participant "DebugSession\nsession.rs" as session
participant "DebugControl\napi.rs" as control
participant "Stop Thread\ncore.rs" as stopThread
participant "StopCoordinator\n(core.rs)" as stopCoord
participant "Runner Thread\ncore.rs" as runner
participant "Runtime\ncycle.rs" as runtime
participant "DebugHook\nhook.rs" as hook
participant "RunControl\n(trust-runtime-services\ndebug/run.rs)" as services

vscode -> adapter : next(threadId) (DAP request)
activate adapter

adapter -> adapter : handle_next()
adapter -> session : debug_control()
session --> adapter : DebugControl ref

adapter -> control : step_over(threadId)\n(thread-scoped)
activate control
control -> services : apply(StepOver(threadId))
note right
    decided in trust-runtime-services:
    StepState {
        kind: Over,
        target_depth: depth of thread,
        started: previous mode was Paused
    }
    mode = Running
    clear pending_stop
end note
control -> control : cvar.notify_all() (resumed)
deactivate control

adapter --> vscode : ok response
note right
    StopGate token held until
    response is flushed.
end note

... Runner thread wakes up ...

runner -> runtime : execute_cycle()
activate runtime
runtime -> control : begin_cycle()\nclear stopped breakpoint identities

loop for each statement
    note over runtime
        Statement starts and byte spans come from the
        LINE_TABLE bound at install; DEBUG_MAP is read
        only for a module without one.
    end note
    runtime -> hook : on_statement(location, call_depth)
    activate hook

    hook -> services : boundary(call_depth, breakpoint match)
    note right
        the step decides first:
        if step.started &&
           call_depth <= target_depth
        the breakpoint match (count, cycle guard,
        condition) runs only when no step stops
    end note

    alt should pause
        hook -> hook : publish the halted state
        hook -> stopThread : emit DebugStop(Step, threadId)\n(generation ok)
        hook -> hook : cvar.wait() [BLOCKS]\n(the hold: Mutex + Condvar only)
        note right
            On a chip the hold is the hold pass of
            the resource loop (runner/hold.rs): it
            serves the link, runs the idle work,
            feeds the watchdog and waits, until
            RunControl says the scan is released.
        end note
    else continue
        hook --> runtime : return
    end
    deactivate hook
end

deactivate runtime

... Stop event received ...

stopThread -> stopCoord : DebugStop(Step)
stopCoord -> stopCoord : stop_gate.wait_clear()
note right
    DAP ordering:
    responses first, then stopped event.
end note
stopCoord -> adapter : ordered stop event
adapter -> vscode : stopped event\n{reason: "step"}
adapter -> vscode : invalidated event

vscode -> adapter : stackTrace
adapter -> control : get snapshot
control --> adapter : DebugSnapshot
adapter --> vscode : stack frames

vscode -> adapter : variables
adapter -> control : read from snapshot
adapter --> vscode : variable list

@enduml
