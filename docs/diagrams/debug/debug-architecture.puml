@startuml trust-debug-architecture
!theme plain
allowmixing
skinparam backgroundColor #FEFEFE
skinparam componentStyle uml2
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 40

title IEC 61131-3 ST Debug System Architecture

' ============================================================
' VS CODE EXTENSION LAYER
' ============================================================
package "VS Code Extension" as vscode #LightBlue {
    component "DebugConfigurationProvider" as configProvider <<debug/configuration.ts>>
    component "DebugAdapterDescriptorFactory" as adapterFactory <<debug.ts>>
    component "DebugAdapterTrackerFactory" as tracker <<debug.ts>>
    component "Runtime Panel\n(Webview)" as runtimePanel <<ioPanel.ts + io-panel/*>>

    configProvider --> adapterFactory : resolves config
    adapterFactory --> tracker : creates tracker
}

note right of runtimePanel
	    Runtime panel issues custom
	    DAP requests (stIoState, stIoWrite, stReload)
	    stIoState carries runtime-owned
	    I/O source provenance when available
	    and writes workspace settings
	    for runtime control overrides.
	end note

' ============================================================
' DAP PROTOCOL LAYER
' ============================================================
package "DAP Protocol (stdio)" as dap #LightYellow {
    component "stdin" as stdin
    component "stdout" as stdout

    note right of stdin
        Content-Length: n
        CRLF
        JSON payload
        Requests include: LaunchRequest, AttachRequest
    end note
}

vscode -down-> stdin : DAP Requests
stdout -up-> vscode : DAP Responses/Events
runtimePanel -down-> stdin : custom DAP\n(stIoState/stIoWrite/stReload)

' ============================================================
' truST Debug CRATE
' ============================================================
package "trust-debug crate" as stdebug #LightGreen {

    ' Main entry and protocol IO
    component "main.rs" as main
    component "protocol_io.rs" as protocolIo <<read/write messages>>

    ' Session management
    component "DebugSession" as session <<session.rs + session/*>> {
        portin sources
        portin breakpoints
        portin metadata
    }

    ' Debug Adapter
    package "DebugAdapter" as adapter <<mod.rs + core.rs>> {
        component "run_stdio()" as runStdio <<core.rs>>
        component "dispatch_request()" as dispatch <<core.rs>>
        component "LaunchState" as launchState <<mod.rs>>
        component "SessionMode\n(launch/attach)" as sessionMode
        component "RemoteSession\n(control client)" as remoteSession
        component "RemoteStopPoller" as remoteStop
        component "VariableHandles" as varHandles <<mod.rs>>
        component "ThreadMapper" as threadMap <<threads.rs>>
        component "StopCoordinator" as stopCoord
        component "BreakpointManager" as bpManager
        component "PausedStateView" as pausedView
        component "ControlServerBridge" as controlBridge <<control_bridge.rs>>
    }

    ' Background Threads
    package "Background Threads" as threads #PaleGreen {
        component "Log Thread" as logThread <<core.rs>>
        component "IO Thread" as ioThread <<core.rs>>
        component "Stop Thread" as stopThread <<core.rs>>
        component "Runner Thread" as runnerThread <<core.rs>>
    }

    ' Handlers
    package "Handlers" as handlers {
        component "initialize.rs" as initHandler
        component "breakpoints.rs" as bpHandler
        component "run_control.rs" as runHandler
        component "stack_trace.rs" as stackHandler
        component "scopes.rs" as scopesHandler
        component "threads.rs" as threadsHandler
        component "lifecycle.rs" as lifecycleHandler
    }

    ' Variables
    package "Variables" as variables {
        component "list.rs" as varList
        component "eval.rs" as varEval
        component "set/" as varSet
        component "format.rs" as varFormat
    }

    ' IO
    component "io.rs" as ioHandler <<stIoState, stIoWrite>>

    main --> protocolIo
    protocolIo --> runStdio
    runStdio --> dispatch
    dispatch --> handlers
    dispatch --> variables
    dispatch --> ioHandler
    dispatch --> stopCoord
    dispatch --> bpManager
    dispatch --> pausedView
    dispatch --> sessionMode
    dispatch --> controlBridge : launch creates IPC
    sessionMode --> remoteSession : attach
    remoteSession --> remoteStop : stop polling

    handlers --> session
    variables --> session
}

' ============================================================
' truST Runtime CRATE
' ============================================================
package "trust-runtime crate" as struntime #LightCoral {

    ' Debug Control Hub
    package "DebugControl" as debugControl <<debug/control/api.rs>> {
        component "DebugState" as debugState {
            portin mode
            portin breakpoints
            portin steps
            portin target_thread
            portin snapshot
            portin pending_stop
            portin stop_queue
            portin breakpoint_generation
            portin breakpoint_stops_this_cycle
        }
        component "Mutex + Condvar\n(the hold waits here; no decision)" as sync
        component "apply_action()\n(applies RunControl::apply)" as applyAction <<api/lifecycle_actions.rs>>
        component "FrameLocationMap" as frameLocs
    }

    ' Debug Hook
    component "DebugHook trait" as debugHook <<hook.rs>>
    component "on_statement_inner()" as onStatement <<debug/control/hook.rs>>

    ' Breakpoint Logic
    component "matches_breakpoint()" as matchBp <<breakpoints.rs>>

    ' Statement positions: the module's LINE_TABLE, bound at install (runtime/metadata.rs)
    component "LineIndex" as lineIndex <<LINE_TABLE bound at install>>

    ' Snapshot
    component "DebugSnapshot" as snapshot <<debug/control/types.rs>> {
        portin storage
        portin timestamp
    }

    ' Runtime Core
    package "Runtime" as runtime {
        component "execute_cycle()" as execCycle <<cycle.rs:18>>
        component "VariableStorage" as varStorage
        component "DebugRuntimeContext" as debugCtx <<debug/hook.rs>>
        component "helper_eval::storage_lvalue" as debugWrite <<helper_eval/storage_lvalue.rs>>
        component "Task Registry" as taskRegistry
    }

    ' Channels
    package "Channels" as channels {
        component "stop_tx/rx" as stopChannel
        component "log_tx/rx" as logChannel
        component "io_tx/rx" as ioChannel
    }

    debugControl --> sync
    debugControl --> debugState
    debugHook <|.. debugControl : implements
    onStatement --> matchBp : breakpoint match, asked by\nboundary() when no step stops
    onStatement --> boundaryDecision : boundary(), take_pending_stop()\nand holds_here() decide
    onStatement --> sync : waits while the\nrun control holds the scan
    applyAction --> applyDecision : apply(action)
    debugControl --> releaseDecision : release_for_stop(), rearm(),\nretire_observations()
    debugControl --> holdDecision : hold_reason(), accepts_step()\n(status and step requests)
    onStatement --> snapshot : captures
    onStatement --> frameLocs : per-frame location

    execCycle --> debugState : begin_cycle()\nclear stopped identities
    execCycle --> debugWrite : pending debug writes
    debugCtx --> debugHook : storage-native statement context

    onStatement --> stopChannel : emit DebugStop
    onStatement --> lineIndex : statement start\n(DEBUG_MAP is read only without a LINE_TABLE)
    lineIndex --> matchBp : byte spans of\ntable statements

note right of lineIndex
    The LINE_TABLE decides every statement
    start, breakpoint and stop position.
    The source text only projects those
    positions to byte offsets.
end note
}

' ============================================================
' SHARED RUN CONTROL (trust-runtime-services debug/run.rs)
' No lock, no thread and no clock: the decisions only.
' ============================================================
package "trust-runtime-services\ndebug/run.rs (RunControl)" as sharedRun #PaleGreen {
    component "RunControl\n(run fields borrowed for one decision)" as runControl {
        portin mode
        portin pending_stop
        portin steps
        portin target_thread
        portin stop_requested
    }
    component "boundary()\nstep first, then breakpoint;\nstop emitted and mode Paused" as boundaryDecision
    component "take_pending_stop(), holds_here()\nwhether the held scan waits;\nhold_reason(), accepts_step() for status and steps" as holdDecision
    component "apply(): pause, continue,\nstep in, over, out" as applyDecision
    component "release_for_stop(), rearm()\nresource stop ends the holds;\nretire_observations() on a schema change" as releaseDecision

    runControl --> boundaryDecision
    runControl --> holdDecision
    runControl --> applyDecision
    runControl --> releaseDecision
    boundaryDecision ..> onStatement : asks for the breakpoint match\nonly when no step stops
}

' ============================================================
' CONTROL SERVER (IPC)
' ============================================================
package "ControlServer (IPC)" as controlServer #LightCoral {
    component "control/transport.rs" as controlCore
    component "trust-runtime-services\ndispatch.rs\nprepare_line / dispatch_value" as sharedDispatch
    component "control auth gate" as controlAuth
    component "trust-runtime-services\naccess/registry.rs" as operationRegistry
    component "trust-runtime-services\naccess/policy.rs\nparameter-sensitive roles" as rolePolicy
    component "trust-runtime-services\nstatus.rs, events.rs, resource/\nstatus, health, events, faults,\npause, resume, restart, shutdown" as sharedHandlers
    component "control/host_ports.rs\nports on ControlState" as hostPorts
    component "debug.* and other host endpoints" as debugEndpoints
    controlCore --> sharedDispatch
    sharedDispatch --> controlAuth
    controlAuth --> operationRegistry : classify operation + debug surface
    controlAuth --> rolePolicy : resolve parameter-sensitive minimum role
    sharedDispatch --> sharedHandlers : shared operations
    sharedHandlers --> hostPorts : state, scheduler, events, clock
    sharedDispatch --> debugEndpoints : other operations through the host port
}

' ============================================================
' A DEVICE'S HOLD (trust-runtime-services runner/)
' The same decisions, taken inside the engine's statement hook of a chip. The scan's
' native frames stay on the stack while it is held, so the hold runs a pass of its own
' (serve the link, idle work, watchdog feed, wait) instead of the loop's run_pass().
' ============================================================
package "trust-runtime-services\nrunner/ (a device's hold)" as chipHold #PaleGreen {
    component "DeviceServices\non_statement_with_frame_checked()\none check while debugging is off;\nthe LINE_TABLE names the statement starts" as chipHook
    component "ChipDebug (debugger.rs)\nthe fields RunControl borrows,\nbreakpoints, cycle suppression,\nthe last stop" as chipDebug
    component "hold pass (hold.rs)\nserve up to 8 requests, idle(),\nfeed the watchdog, wait: one feed\ninterval, 1 ms while a reply is in flight;\nhold_started() / hold_ended()" as holdPass
    component "Shell (shell.rs)\nlink, wait, platform, receive buffer,\nresource state, records, debugger;\neach RefCell is borrowed by one leaf\noperation at a time" as chipShell
    component "Runner::run_pass()\nbetween scans; Runner::scan() holds\nno RefCell guard across run_scan()" as chipRunner
    component "debug/requests.rs\nthe debug operations (debug.*,\nbreakpoints.*, step_*), answered\nfrom the Debugger port" as debugRequests
    component "runner/debug_port.rs\nDebugger over the loop: published\nreads, LINE_TABLE sources,\nframe names from the prepared program" as debugPort
    component "debug/replies.rs, projection.rs\nthe one reply builder of every runtime;\nthe handle table, bound 256 on a chip;\nrefusals with stable codes" as debugReplies

    chipHook --> chipDebug : at_statement()
    debugRequests --> debugPort : Debugger port:\nstate, stops, breakpoints, handles
    debugRequests --> debugReplies : reply shapes,\nrefusals
    debugPort --> chipDebug : the fields the port reads\nand changes
    chipDebug --> runControl : boundary(), take_pending_stop(),\nholds_here()
    chipHook --> holdPass : hold() until the debugger\nreleases the scan
    holdPass --> chipDebug : holds_here() after each pass
    holdPass --> chipShell : serve, idle, feed, wait
    chipRunner --> chipShell : serve, idle, feed, wait
    chipShell --> sharedDispatch : prepare_line_within():\nstatus, health, pause, resume,\nshutdown while held
    sharedDispatch --> debugRequests : debug operations on a chip\n(specification 11 §6.13.3)

    ' A compiled program (specification 44 §13.2): the module calls the kernel's stop at an armed
    ' statement; the cycle asks the same debugger and holds with the held scan's memory.
    component "trust-plc-abi kernel/stops.rs\nstop_to_sink(): the stop goes to the\nsink behind Cx.kernel; the Frame chain,\nthe areas and frames as cells" as kernelStops
    component "trust-runtime-core native/stop.rs\nStop: statement, depth, frames;\nHeldScan hands it to ScanHooks::on_stop" as kernelStop
    component "runner/compiled.rs + compiled/debug.rs\narm the statements before each scan\n(breakpoint starts or every one),\non_stop: at_statement, hold_compiled,\nLive Values at HoldEnd, re-arm" as compiledDebug
    component "debug/compiled.rs\ndebug.stack, debug.scopes, debug.variables\nthrough the symbol table (ProgramMemory)" as compiledReads

    kernelStops --> kernelStop : stop(cx, stmt)
    kernelStop --> compiledDebug : on_stop(Stop)
    compiledDebug --> chipDebug : at_statement(), stop_points()
    compiledDebug --> holdPass : hold_compiled() until the\ndebugger releases the scan
    debugRequests --> compiledReads : a compiled program's\nstack, scopes, variables
}

note right of holdPass
    A hold ends at resume, at a step's
    own boundary or at a stop request
    (shutdown). Time, the cycle watchdog,
    a new host session and a missing
    debugger do not end it. It runs no
    boundary: no scan starts, no output
    is committed, no retain step runs.
end note

note right of debugReplies
    breakpoints.list entry, one shape on every runtime:
    file_id, line, column, end_line, end_column
    (zero-based). A computer adds start and end,
    its byte offsets; a chip has no text to count them.
    Instances list in ascending instance identifier.
end note

remoteSession -down-> controlServer : JSON IPC (debug.*)
controlBridge -down-> controlServer : JSON IPC (debug.*)

note right of remoteSession
    Attach mode bypasses DebugRuntime and
    uses the control IPC (debug.*) directly.
end note

note right of controlBridge
    Launch mode spins up a local
    control IPC for inline values
    and tooling integration.
end note

' ============================================================
' RUNTIME FACADE
' ============================================================
package "Runtime Bridge" as runtimeBridge #Wheat {
    interface "DebugRuntime" as debugRuntime {
        +compile()
        +control()
        +snapshot()
        +io_state()
        +reload()
    }
}

' ============================================================
' CONNECTIONS BETWEEN CRATES
' ============================================================

' Session to Runtime
session -down-> debugControl : debug_control()
session -down-> runtime : runtime_handle()
session -down-> debugRuntime : facade
debugRuntime <|.. session : implements

' Threads to Channels
stopThread <-left- stopChannel : receives DebugStop
stopThread --> stopCoord : ordered stop events
logThread <-left- logChannel : receives DebugLog
ioThread <-left- ioChannel : receives IoSnapshot

' Runner to Runtime
runnerThread -down-> execCycle : calls

' Handler connections
runHandler -down-> debugControl : continue/pause/step
bpHandler -down-> bpManager : resolve + generation
bpManager -down-> debugControl : set_breakpoints_for_file()
stackHandler -down-> pausedView : frames
varList -down-> pausedView : variables
varEval -down-> pausedView : evaluate expression
threadsHandler -down-> threadMap : tasks -> DAP threads

' ============================================================
' REQUEST FLOW ANNOTATIONS
' ============================================================

note bottom of dispatch
    **Request Routing:**
    initialize → initHandler
    launch → initHandler
    configurationDone → initHandler
    setBreakpoints → bpHandler
    continue/pause/next/stepIn/stepOut → runHandler
    threads → threadsHandler
    stackTrace → stackHandler
    scopes → scopesHandler
    variables → varList
    evaluate → varEval
    setVariable → varSet
    disconnect/terminate/stReload → lifecycleHandler
    stIoState/stIoWrite → ioHandler
end note

note right of launchState
    **State Machine:**
    AwaitingConfig → Configured → PostLaunch

    Deferred launch pattern handles
    race between client init and
    breakpoint setup
end note

note right of debugState
    **Debug Modes:**
    - Running
    - Paused

    **Step Types:**
    - StepInto (next statement)
    - StepOver (same depth)
    - StepOut (lower depth)
end note

note right of debugState
    Stop reason integrity:
    only emit breakpoint stops
    if current breakpoints apply.
end note

note right of runHandler
    Pause is idempotent.
    Continue clears pending stop.
end note

note right of session
    Breakpoint generation guards
    prevent stale stops after clear.
end note

note right of frameLocs
    Per-frame source mapping
    for multi-file stepping.
end note

note right of threadMap
    IEC tasks map to DAP threadId.
    step/pause apply per thread.
end note

note right of stopThread
    DAP ordering:
    response first, then stopped event.
end note

note right of lifecycleHandler
    stReload preserves paused/running
    state and revalidates breakpoints.
end note

note right of launchState
    stopOnEntry emits reason=entry.
end note

note bottom of onStatement
    **Called at every statement boundary:**
    1. Update last location and call depth (RunControl)
    2. Emit the pending pause of a held target (RunControl)
    3. RunControl.boundary: step, then breakpoint match
    4. Capture the halted state and emit the stop
    5. Wait on the condvar while RunControl holds the scan
end note

note left of matchBp
    Cyclic task safety:
    cleared breakpoints must
    not re-trigger stale stops.
    One exact breakpoint identity
    stops at most once per scan;
    begin_cycle re-arms it.
end note

note right of stopCoord
    Centralizes stop ordering,
    breakpoint generation checks,
    invalidated events, and
    StopGate sequencing.
end note

note right of bpManager
    Centralizes breakpoint resolve
    + generation tracking (single owner).
end note

note right of pausedView
    Single source of truth for
    paused state (stack/vars/expr).
end note

' ============================================================
' LIFECYCLE SEQUENCE
' ============================================================

legend right
    **Debug Session Lifecycle:**

    1. VS Code spawns trust-debug process
    2. Initialize: Negotiate capabilities
    3. Launch: Load & compile program
    4. ConfigurationDone: Start runner
    5. SetBreakpoints: Register breakpoints
    6. Continue/Step: Control execution
    7. Stopped event: Hit breakpoint/step
    8. StackTrace/Variables: Inspect state
    9. Disconnect: Cleanup & exit

    **Key Files:**
    • trust-debug/src/adapter/core.rs
    • trust-debug/src/session.rs + trust-debug/src/session/*
    • trust-runtime/src/debug/control/api.rs
    • trust-runtime/src/debug/control/hook.rs
end legend

@enduml
