@startuml compiled-binding-sources
!theme plain
title Sources used for compiled PLC bindings
actor "Plant editor / HMI setup" as ui
participant "LSP command handler" as command
participant "load_hmi_sources" as loader
participant "Runtime compiler" as compiler
ui -> command : Request compiled bindings
command -> loader : Read project ST sources
loader -> loader : Exclude files with @trustlsp:runtime-ignore\nin their first 20 lines
loader --> command : Runtime sources only
command -> compiler : Compile retained sources
alt Runtime source error
compiler --> command : Compile error
command --> ui : Explain error; no catalog
else Successful compilation
compiler --> command : Runtime metadata
command --> ui : Configured PLC bindings
end
@enduml
