{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/invariant-seed-audit-report.schema.json",
  "title": "truST Phase 4 invariant-seed audit report",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "generator_version",
    "report_status",
    "input_digest",
    "command",
    "commit",
    "timestamp",
    "platform",
    "input_paths",
    "output_paths",
    "scope",
    "rows",
    "summary",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "generator": { "const": "invariant-seed-audit" },
    "generator_version": { "const": 2 },
    "report_status": { "const": "complete" },
    "input_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "input_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "output_paths": { "$ref": "#/$defs/output_paths" },
    "scope": { "$ref": "#/$defs/scope" },
    "rows": {
      "type": "array",
      "minItems": 44,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "output_paths": {
      "type": "object",
      "required": ["json", "markdown"],
      "properties": {
        "json": { "type": "string", "minLength": 1 },
        "markdown": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "source",
        "manifest",
        "proof_created",
        "spec_gaps_closed",
        "runtime_behavior_changed"
      ],
      "properties": {
        "source": { "const": "initial_high_risk_invariant_seeds" },
        "manifest": { "const": "verification/invariant-seeds.toml" },
        "proof_created": { "const": false },
        "spec_gaps_closed": { "const": false },
        "runtime_behavior_changed": { "const": false }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": [
        "seed_id",
        "seed_title",
        "source_section",
        "source_line",
        "canonical_invariant_id",
        "invariant_path",
        "invariant_area",
        "board_row",
        "origin",
        "lifecycle_version",
        "lifecycle_state",
        "status",
        "proof_level",
        "risk",
        "oracle_ref",
        "spec_gap_refs",
        "source_refs",
        "test_ids",
        "evidence_ids",
        "p4_000_risk_id"
      ],
      "properties": {
        "seed_id": { "type": "string", "minLength": 1 },
        "seed_title": { "type": "string", "minLength": 1 },
        "source_section": { "type": "string", "minLength": 1 },
        "source_line": { "type": "integer", "minimum": 1 },
        "canonical_invariant_id": { "type": "string", "minLength": 1 },
        "invariant_path": { "type": "string", "minLength": 1 },
        "invariant_area": { "type": "string", "minLength": 1 },
        "board_row": {
          "enum": [
            "VERIF-P4-001",
            "VERIF-P4-002",
            "VERIF-P4-003",
            "VERIF-P4-004",
            "VERIF-P4-005",
            "VERIF-P4-006",
            "VERIF-P4-007",
            "VERIF-P4-008"
          ]
        },
        "origin": { "enum": ["phase4", "preexisting"] },
        "lifecycle_version": { "const": 1 },
        "lifecycle_state": { "enum": ["baseline", "execution_ready"] },
        "status": { "enum": ["gap_open", "spec_gap", "test_written", "implemented", "validated"] },
        "proof_level": { "enum": ["S0", "G1", "G2", "R1"] },
        "risk": { "type": "string", "minLength": 1 },
        "oracle_ref": { "type": "string", "minLength": 1 },
        "spec_gap_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "test_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "p4_000_risk_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "board_count": {
      "type": "object",
      "required": ["board_row", "seeds"],
      "properties": {
        "board_row": { "type": "string", "minLength": 1 },
        "seeds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "seeds",
        "canonical_invariants",
        "merged_seed_aliases",
        "phase4_records",
        "preexisting_seed_mappings",
        "baseline_lifecycle",
        "execution_ready_lifecycle",
        "gap_open",
        "spec_gap",
        "test_written",
        "implemented",
        "validated",
        "p4_000_risks",
        "by_board_row"
      ],
      "properties": {
        "seeds": { "type": "integer", "minimum": 44 },
        "canonical_invariants": { "type": "integer", "minimum": 43 },
        "merged_seed_aliases": { "type": "integer", "minimum": 1 },
        "phase4_records": { "type": "integer", "minimum": 1 },
        "preexisting_seed_mappings": { "type": "integer", "minimum": 1 },
        "baseline_lifecycle": { "const": 0 },
        "execution_ready_lifecycle": { "const": 44 },
        "gap_open": { "type": "integer", "minimum": 0 },
        "spec_gap": { "type": "integer", "minimum": 0 },
        "test_written": { "type": "integer", "minimum": 0 },
        "implemented": { "type": "integer", "minimum": 0 },
        "validated": { "type": "integer", "minimum": 0 },
        "p4_000_risks": { "type": "integer", "minimum": 5 },
        "by_board_row": {
          "type": "array",
          "minItems": 8,
          "items": { "$ref": "#/$defs/board_count" }
        }
      },
      "additionalProperties": false
    }
  }
}
