{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/code-spec-risk-acknowledgements.schema.json",
  "title": "truST Phase 17 symbol-specific risk acknowledgements",
  "type": "object",
  "required": ["schema_version", "acknowledgements"],
  "properties": {
    "schema_version": { "const": 1 },
    "acknowledgements": {
      "type": "array",
      "items": { "$ref": "#/$defs/acknowledgement" }
    }
  },
  "$defs": {
    "acknowledgement": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "code_id",
        "owner",
        "area",
        "body_digest",
        "risk_signals",
        "review_ref",
        "reviewed_by",
        "reviewed_on",
        "expires_on",
        "rationale"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "type": "string", "pattern": "^RISK_ACK_[0-9A-F]{64}$" },
        "code_id": { "type": "string", "pattern": "^CODE_[0-9A-F]{64}$" },
        "owner": { "type": "string", "minLength": 1 },
        "area": {
          "enum": [
            "bytecode_vm",
            "compiler_iec",
            "control_security",
            "editor_safety",
            "hmi_ui",
            "plcopen_devtools",
            "protocols",
            "release",
            "runtime_safety",
            "supply_chain_platform",
            "verification"
          ]
        },
        "body_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "risk_signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "authorization",
              "broad_error_suppression",
              "fault_mapping",
              "filesystem_or_environment",
              "host_time",
              "network_io",
              "output_or_safe_state_commit",
              "persistence_retain_reload_restart",
              "protocol_response_or_status",
              "randomness",
              "state_mutation",
              "subprocess_or_thread",
              "unsafe_or_ffi"
            ]
          }
        },
        "review_ref": {
          "type": "string",
          "pattern": "^[^#]+#[A-Za-z0-9._:-]+$"
        },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "reviewed_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "expires_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
