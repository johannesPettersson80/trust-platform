{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/test-catalog-denominator.schema.json",
  "title": "Exhaustive Existing-Test Catalog Denominator",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "denominator_basis",
    "review_basis",
    "reason_definitions",
    "last_reviewed",
    "reviews"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "const": "TEST_CATALOG_DENOMINATOR_REVIEW_V1" },
    "title": { "type": "string", "minLength": 1 },
    "denominator_basis": { "const": "all_live_existing_test_scanner_facts" },
    "review_basis": { "const": "explicit_per_discovery_id_no_semantic_inference" },
    "reason_definitions": {
      "type": "object",
      "required": [
        "no_reviewed_spec_or_invariant_binding",
        "assertion_oracle_unresolved",
        "not_catalogable_product_oracle",
        "ignored_test_registry_owned",
        "fuzz_program_owned",
        "gate_inventory_owned"
      ],
      "properties": {
        "no_reviewed_spec_or_invariant_binding": { "const": "The fact remains part of its native test suite, but no hand-reviewed catalog row authorizes a specification, invariant, oracle, or expected-result claim for it. It is retired from mapping debt without being deleted." },
        "assertion_oracle_unresolved": { "const": "The test has product-facing assertions, but the reviewed assertion extractor cannot close one or more helper or external-oracle calls. It remains runnable and explicit without claiming catalog proof." },
        "not_catalogable_product_oracle": { "const": "The test is a harness, static-presence, zero-assertion, or authority-contradictory check that cannot honestly prove an accepted product invariant. It remains runnable without catalog proof." },
        "ignored_test_registry_owned": { "const": "The ignored or conditional fact is governed by its exact Phase 3 ignored-test registry row and has no separate hand-reviewed invariant catalog mapping." },
        "fuzz_program_owned": { "const": "The fuzz target is governed by the dedicated Phase 9 fuzz-program and crash-regression ledgers rather than an inferred invariant catalog mapping." },
        "gate_inventory_owned": { "const": "The gate script or workflow job is governed by the Phase 5 gate inventory and suite-routing contracts rather than a product-test invariant mapping." }
      },
      "additionalProperties": false
    },
    "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/catalog_mapped" },
          { "$ref": "#/$defs/reviewed_nonmapping" }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identity": {
      "required": [
        "discovery_id",
        "discovery_source_kind",
        "path",
        "name",
        "ignore_state",
        "disposition",
        "last_reviewed"
      ],
      "properties": {
        "discovery_id": { "type": "string", "pattern": "^DISC_[A-F0-9]{20}$" },
        "discovery_source_kind": {
          "enum": [
            "conformance_case",
            "fuzz_target",
            "gate_script",
            "github_workflow_job",
            "rust_integration_test",
            "rust_unit_test",
            "structured_text_test",
            "vscode_test"
          ]
        },
        "path": { "type": "string", "pattern": "^[^/\\\\][^\\\\]*$" },
        "name": { "type": "string", "minLength": 1 },
        "ignore_state": { "enum": ["not_ignored", "ignored", "conditional"] },
        "disposition": { "enum": ["catalog_mapped", "reviewed_nonmapping"] },
        "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "catalog_mapped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_id",
        "discovery_source_kind",
        "path",
        "name",
        "ignore_state",
        "disposition",
        "catalog_test_id",
        "last_reviewed"
      ],
      "properties": {
        "discovery_id": { "$ref": "#/$defs/identity/properties/discovery_id" },
        "discovery_source_kind": { "$ref": "#/$defs/identity/properties/discovery_source_kind" },
        "path": { "$ref": "#/$defs/identity/properties/path" },
        "name": { "$ref": "#/$defs/identity/properties/name" },
        "ignore_state": { "$ref": "#/$defs/identity/properties/ignore_state" },
        "disposition": { "const": "catalog_mapped" },
        "catalog_test_id": { "type": "string", "pattern": "^TEST_[A-Z0-9_]+$" },
        "last_reviewed": { "$ref": "#/$defs/identity/properties/last_reviewed" }
      }
    },
    "reviewed_nonmapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_id",
        "discovery_source_kind",
        "path",
        "name",
        "ignore_state",
        "disposition",
        "reason_code",
        "last_reviewed"
      ],
      "properties": {
        "discovery_id": { "$ref": "#/$defs/identity/properties/discovery_id" },
        "discovery_source_kind": { "$ref": "#/$defs/identity/properties/discovery_source_kind" },
        "path": { "$ref": "#/$defs/identity/properties/path" },
        "name": { "$ref": "#/$defs/identity/properties/name" },
        "ignore_state": { "$ref": "#/$defs/identity/properties/ignore_state" },
        "disposition": { "const": "reviewed_nonmapping" },
        "reason_code": {
          "enum": [
            "no_reviewed_spec_or_invariant_binding",
            "assertion_oracle_unresolved",
            "not_catalogable_product_oracle",
            "ignored_test_registry_owned",
            "fuzz_program_owned",
            "gate_inventory_owned"
          ]
        },
        "last_reviewed": { "$ref": "#/$defs/identity/properties/last_reviewed" }
      }
    }
  }
}
