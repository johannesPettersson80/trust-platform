{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/test-refactor-proposal.schema.json",
  "title": "truST reviewed test-refactor proposal file",
  "type": "object",
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["discovery_id", "discovery_source_kind", "path", "name"],
      "properties": {
        "discovery_id": { "type": "string", "pattern": "^DISC_[A-F0-9]{20}$" },
        "discovery_source_kind": {
          "enum": [
            "rust_integration_test",
            "rust_unit_test",
            "structured_text_test",
            "vscode_test",
            "conformance_case",
            "fuzz_target",
            "gate_script",
            "github_workflow_job"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "fixture_ownership": {
      "type": "object",
      "required": ["before_owner", "after_owner", "review"],
      "properties": {
        "before_owner": { "type": "string", "minLength": 1 },
        "after_owner": { "type": "string", "minLength": 1 },
        "review": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "design_review": {
      "type": "object",
      "required": ["solid", "kiss", "dry", "rationale"],
      "properties": {
        "solid": { "const": "pass" },
        "kiss": { "const": "pass" },
        "dry": { "const": "pass" },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "test_id",
        "disposition",
        "status",
        "lifecycle",
        "source_paths",
        "source_identity",
        "target_identity",
        "decision_inputs",
        "finding_refs",
        "before_command",
        "after_command",
        "invariant_ids",
        "coverage_dimensions",
        "fixture_ownership",
        "stale_path_updates",
        "expected_behavior_delta",
        "design_review",
        "rationale",
        "last_reviewed"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "type": "string", "pattern": "^TEST_REFACTOR_[A-Z0-9_]+$" },
        "test_id": { "type": "string", "pattern": "^TEST_[A-Z0-9_]+$" },
        "disposition": { "enum": ["move", "split", "rename", "no_refactor_needed"] },
        "status": {
          "enum": ["proposed", "approved", "in_progress", "completed", "validated", "rejected"]
        },
        "lifecycle": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["proposed", "reviewed", "approved", "in_progress", "completed", "validated", "rejected"] }
        },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source_identity": { "$ref": "#/$defs/identity" },
        "target_identity": { "$ref": "#/$defs/identity" },
        "decision_inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "finding_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "before_command": { "type": "string", "minLength": 1 },
        "after_command": { "type": "string", "minLength": 1 },
        "invariant_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "uniqueItems": true
        },
        "coverage_dimensions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9_]+$" },
          "uniqueItems": true
        },
        "fixture_ownership": { "$ref": "#/$defs/fixture_ownership" },
        "stale_path_updates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "expected_behavior_delta": { "const": "none" },
        "design_review": { "$ref": "#/$defs/design_review" },
        "rationale": { "type": "string", "minLength": 1 },
        "before_behavior_lock_evidence": { "type": "string", "pattern": "^EVID_[A-Z0-9_]+$" },
        "after_behavior_lock_evidence": { "type": "string", "pattern": "^EVID_[A-Z0-9_]+$" },
        "last_reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    }
  }
}
