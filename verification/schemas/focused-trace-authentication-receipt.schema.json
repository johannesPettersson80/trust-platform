{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-platform.dev/schemas/focused-trace-authentication-receipt.schema.json",
  "title": "Focused trace authentication receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_commit",
    "trace_digest",
    "rebuilt_trace_digest",
    "trace_root",
    "requested_discovery_ids",
    "requested_tests_digest",
    "resolved_digest",
    "raw_evidence",
    "source_files"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "focused_trace_authentication_receipt_v1" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "trace_digest": { "$ref": "#/$defs/digest" },
    "rebuilt_trace_digest": { "$ref": "#/$defs/digest" },
    "trace_root": { "type": "string", "minLength": 1 },
    "requested_discovery_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^DISC_[0-9A-F]{20}$" }
    },
    "requested_tests_digest": { "$ref": "#/$defs/digest" },
    "resolved_digest": { "$ref": "#/$defs/digest" },
    "raw_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "repository_files",
        "executable_files",
        "tool_digests",
        "tool_paths"
      ],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "repository_files": { "$ref": "#/$defs/digest_map" },
        "executable_files": { "$ref": "#/$defs/digest_map" },
        "tool_digests": { "$ref": "#/$defs/digest_map" },
        "tool_paths": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_files": { "$ref": "#/$defs/digest_map" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/digest" }
    }
  }
}
