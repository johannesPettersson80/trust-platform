{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/mapping-candidates.schema.json",
  "title": "Execution-guided test-catalog mapping candidates",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "generator_version",
    "source_commit",
    "trace_digest",
    "candidates",
    "demands",
    "demand_ranking",
    "unmapped_code_demand_ranking"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generator": { "const": "test-mapping-candidates" },
    "generator_version": { "type": "string", "minLength": 1 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "trace_digest": { "$ref": "#/$defs/digest" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "demands": {
      "type": "array",
      "items": { "$ref": "#/$defs/demand" }
    },
    "demand_ranking": {
      "type": "array",
      "items": { "$ref": "#/$defs/demand_ranking" }
    },
    "unmapped_code_demand_ranking": {
      "type": "array",
      "items": { "$ref": "#/$defs/unmapped_code_demand_ranking" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "discovery_id": {
      "type": "string",
      "pattern": "^DISC_[A-F0-9]{20}$"
    },
    "code_id": {
      "type": "string",
      "pattern": "^CODE_[A-F0-9]{64}$"
    },
    "code_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/code_id" },
      "uniqueItems": true
    },
    "candidate": {
      "type": "object",
      "required": [
        "discovery_id",
        "candidate_tier",
        "candidate_invariant_ids",
        "covered_code_ids",
        "specified_code_ids",
        "spec_gap_code_ids",
        "spec_gap_refs",
        "unmapped_code_ids",
        "concentration_ppm",
        "mutation_kill_ids"
      ],
      "properties": {
        "discovery_id": { "$ref": "#/$defs/discovery_id" },
        "candidate_tier": { "enum": ["C1", "C2", "C3"] },
        "candidate_invariant_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "uniqueItems": true
        },
        "covered_code_ids": { "$ref": "#/$defs/code_ids" },
        "specified_code_ids": { "$ref": "#/$defs/code_ids" },
        "spec_gap_code_ids": { "$ref": "#/$defs/code_ids" },
        "spec_gap_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^SPEC_GAP_[A-Z0-9_]+$" },
          "uniqueItems": true
        },
        "unmapped_code_ids": { "$ref": "#/$defs/code_ids" },
        "concentration_ppm": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "mutation_kill_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "demand": {
      "type": "object",
      "required": [
        "discovery_id",
        "candidate_tier",
        "covered_code_ids",
        "spec_gap_refs",
        "unmapped_code_ids"
      ],
      "properties": {
        "discovery_id": { "$ref": "#/$defs/discovery_id" },
        "candidate_tier": { "const": "C4" },
        "covered_code_ids": { "$ref": "#/$defs/code_ids" },
        "spec_gap_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^SPEC_GAP_[A-Z0-9_]+$" },
          "uniqueItems": true
        },
        "unmapped_code_ids": { "$ref": "#/$defs/code_ids" }
      },
      "additionalProperties": false
    },
    "demand_ranking": {
      "type": "object",
      "required": [
        "spec_gap_ref",
        "affected_discovery_ids",
        "covered_code_ids",
        "tests_unblocked",
        "code_facts_unblocked"
      ],
      "properties": {
        "spec_gap_ref": {
          "type": "string",
          "pattern": "^SPEC_GAP_[A-Z0-9_]+$"
        },
        "affected_discovery_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/discovery_id" },
          "uniqueItems": true
        },
        "covered_code_ids": { "$ref": "#/$defs/code_ids" },
        "tests_unblocked": { "type": "integer", "minimum": 1 },
        "code_facts_unblocked": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "unmapped_code_demand_ranking": {
      "type": "object",
      "required": [
        "area",
        "affected_discovery_ids",
        "covered_code_ids",
        "tests_affected",
        "code_facts_missing"
      ],
      "properties": {
        "area": { "type": "string", "minLength": 1 },
        "affected_discovery_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/discovery_id" },
          "uniqueItems": true
        },
        "covered_code_ids": { "$ref": "#/$defs/code_ids" },
        "tests_affected": { "type": "integer", "minimum": 1 },
        "code_facts_missing": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
