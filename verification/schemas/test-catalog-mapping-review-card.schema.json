{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/test-catalog-mapping-review-card.schema.json",
  "title": "Generated numbered mapping review card",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "generator_version",
    "source_commit",
    "proposal_queue_digest",
    "proposals"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generator": { "const": "test-catalog-mapping-review-card" },
    "generator_version": { "const": "2" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "proposal_queue_digest": { "$ref": "#/$defs/digest" },
    "proposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposal" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "strings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "proposal": {
      "type": "object",
      "required": [
        "proposal_index",
        "proposal_id",
        "discovery_id",
        "candidate_tier",
        "path",
        "name",
        "command",
        "duration_ms",
        "duration_class",
        "suggested_test_class",
        "invariants",
        "behaviors",
        "assertions"
      ],
      "properties": {
        "proposal_index": { "type": "integer", "minimum": 1 },
        "proposal_id": { "type": "string", "pattern": "^MAP_CAND_[A-F0-9_]+$" },
        "discovery_id": { "type": "string", "pattern": "^DISC_[A-F0-9]{20}$" },
        "candidate_tier": { "enum": ["C1", "C2", "C3"] },
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "duration_class": { "enum": ["very_fast", "fast", "medium", "slow", "long"] },
        "suggested_test_class": { "type": "string", "minLength": 1 },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/invariant" }
        },
        "behaviors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/behavior" }
        },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion" }
        }
      },
      "additionalProperties": false
    },
    "invariant": {
      "type": "object",
      "required": [
        "invariant_index",
        "invariant_id",
        "title",
        "area",
        "owner",
        "risk",
        "oracle_ref",
        "suite_tiers"
      ],
      "properties": {
        "invariant_index": { "type": "integer", "minimum": 1 },
        "invariant_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "area": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 },
        "oracle_ref": { "type": "string", "minLength": 1 },
        "suite_tiers": { "$ref": "#/$defs/strings" }
      },
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "required": [
        "behavior_index",
        "behavior_ref",
        "invariant_index",
        "case_family",
        "outcome",
        "rationale"
      ],
      "properties": {
        "behavior_index": { "type": "integer", "minimum": 1 },
        "behavior_ref": { "type": "string", "minLength": 1 },
        "invariant_index": { "type": "integer", "minimum": 1 },
        "case_family": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": [
        "assertion_index",
        "assertion_id",
        "kind",
        "function",
        "line",
        "expression"
      ],
      "properties": {
        "assertion_index": { "type": "integer", "minimum": 1 },
        "assertion_id": { "type": "string", "pattern": "^ASSERT_[A-F0-9]{24}$" },
        "kind": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "expression": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
