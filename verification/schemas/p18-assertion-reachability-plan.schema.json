{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-platform.invalid/schemas/p18-assertion-reachability-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "owner", "last_reviewed", "shards"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "const": "P18_ASSERTION_REACHABILITY_PLAN_V1" },
    "status": { "const": "open" },
    "owner": { "const": "verification" },
    "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "shards": {
      "type": "array",
      "items": { "$ref": "#/$defs/shard" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "command": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "discovery_id", "path", "name", "command"],
      "properties": {
        "test_id": { "type": "string", "pattern": "^TEST_[A-Z0-9_]+$" },
        "discovery_id": { "type": "string", "pattern": "^DISC_[A-F0-9]{20}$" },
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "command": { "$ref": "#/$defs/command" }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "genre", "replacement", "selector_name"],
      "properties": {
        "id": { "type": "string", "pattern": "^MUTANT_[A-Z0-9_]+$" },
        "genre": { "type": "string", "minLength": 1 },
        "replacement": { "type": "string" },
        "selector_name": { "type": "string", "minLength": 1 }
      }
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "owner", "code_id", "invariant_id", "invariant_path",
        "invariant_contract_digest", "source_file", "source_digest", "function",
        "package", "build_command", "tests", "mutations"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^ASSERTION_REACHABILITY_[A-Z0-9_]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "code_id": { "type": "string", "pattern": "^CODE_[A-F0-9]{64}$" },
        "invariant_id": { "type": "string", "minLength": 1 },
        "invariant_path": { "type": "string", "minLength": 1 },
        "invariant_contract_digest": { "$ref": "#/$defs/digest" },
        "source_file": { "type": "string", "minLength": 1 },
        "source_digest": { "$ref": "#/$defs/digest" },
        "function": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "build_command": { "$ref": "#/$defs/command" },
        "tests": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/test" }
        },
        "mutations": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/mutation" }
        }
      }
    }
  }
}
