{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/test-catalog-mapping-review-recommendations.schema.json",
  "title": "Numeric semantic mapping review recommendations",
  "type": "object",
  "required": ["schema_version", "reviewer_id", "range", "reviews"],
  "properties": {
    "schema_version": { "const": 1 },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/review" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "positive_indices": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "evidence": { "type": "string", "minLength": 1 },
    "review": {
      "oneOf": [
        { "$ref": "#/$defs/accepted" },
        { "$ref": "#/$defs/rejected" },
        { "$ref": "#/$defs/confirmed" }
      ]
    },
    "accepted": {
      "type": "object",
      "required": [
        "proposal_index",
        "outcome",
        "evidence",
        "selected_invariant_indices",
        "oracle_bindings",
        "setup_assertion_indices",
        "non_oracle_assertion_indices",
        "requires_network"
      ],
      "properties": {
        "proposal_index": { "type": "integer", "minimum": 1 },
        "outcome": { "const": "accepted" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "selected_invariant_indices": {
          "$ref": "#/$defs/positive_indices",
          "minItems": 1
        },
        "oracle_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/oracle_binding" }
        },
        "setup_assertion_indices": { "$ref": "#/$defs/positive_indices" },
        "non_oracle_assertion_indices": { "$ref": "#/$defs/positive_indices" },
        "requires_network": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "oracle_binding": {
      "type": "object",
      "required": ["assertion_index", "behavior_indices"],
      "properties": {
        "assertion_index": { "type": "integer", "minimum": 1 },
        "behavior_indices": {
          "$ref": "#/$defs/positive_indices",
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "required": [
        "proposal_index",
        "outcome",
        "evidence",
        "rejection_reason"
      ],
      "properties": {
        "proposal_index": { "type": "integer", "minimum": 1 },
        "outcome": { "const": "rejected" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "rejection_reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "confirmed": {
      "type": "object",
      "required": ["proposal_index", "outcome", "evidence"],
      "properties": {
        "proposal_index": { "type": "integer", "minimum": 1 },
        "outcome": { "const": "confirmed" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": false
    }
  }
}
