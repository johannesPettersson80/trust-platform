{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/mapping-ground-truth-review.schema.json",
  "title": "Generated hidden-ground-truth semantic mapping review",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "generator_version",
    "source_commit",
    "candidate_report_digest",
    "reviews"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generator": { "const": "mapping-pilot-semantic-review" },
    "generator_version": { "type": "string", "minLength": 1 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_report_digest": { "$ref": "#/$defs/digest" },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/review" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "strings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "review": {
      "type": "object",
      "required": [
        "discovery_id",
        "candidate_signal_digest",
        "test_source_digest",
        "assertion_inventory_digest",
        "reviewer_ids",
        "selected_invariant_ids",
        "selected_behavior_refs",
        "assertion_reviews"
      ],
      "properties": {
        "discovery_id": {
          "type": "string",
          "pattern": "^DISC_[A-F0-9]{20}$"
        },
        "candidate_signal_digest": { "$ref": "#/$defs/digest" },
        "test_source_digest": { "$ref": "#/$defs/digest" },
        "assertion_inventory_digest": { "$ref": "#/$defs/digest" },
        "reviewer_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "selected_invariant_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "uniqueItems": true
        },
        "selected_behavior_refs": { "$ref": "#/$defs/strings" },
        "assertion_reviews": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion_review" }
        }
      },
      "additionalProperties": false
    },
    "assertion_review": {
      "type": "object",
      "required": [
        "assertion_id",
        "disposition",
        "behavior_refs",
        "rationale"
      ],
      "properties": {
        "assertion_id": {
          "type": "string",
          "pattern": "^ASSERT_[A-F0-9]{24}$"
        },
        "disposition": {
          "enum": [
            "oracle_bound",
            "setup_or_precondition",
            "non_oracle"
          ]
        },
        "behavior_refs": { "$ref": "#/$defs/strings" },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
