{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-platform.invalid/schemas/p18-assertion-reachability.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "proof_class", "producer", "source_sha",
    "input_digest", "input_paths", "status", "summary", "records"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "proof_class": { "const": "assertion_reachability" },
    "producer": { "const": "p18-assertion-reachability.py v1" },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "input_digest": { "$ref": "#/$defs/digest" },
    "input_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": { "enum": ["open", "closed"] },
    "summary": { "$ref": "#/$defs/summary" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "command": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command", "exit_status", "timed_out", "stdout", "stderr", "result"
      ],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "exit_status": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "result": { "enum": ["passed", "not_run", "timeout", "harness_failure"] }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "source_file", "function", "genre", "replacement",
        "generated_mutant_name", "build_command", "build_exit_status",
        "build_timed_out", "build_stdout", "build_stderr",
        "test_command", "test_exit_status",
        "test_timed_out", "test_stdout", "test_stderr",
        "selected_test_failed", "result"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^MUTANT_[A-Z0-9_]+$" },
        "source_file": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 },
        "genre": { "type": "string", "minLength": 1 },
        "replacement": { "type": "string" },
        "generated_mutant_name": { "type": "string", "minLength": 1 },
        "build_command": { "$ref": "#/$defs/command" },
        "build_exit_status": { "type": ["integer", "null"] },
        "build_timed_out": { "type": "boolean" },
        "build_stdout": { "type": "string" },
        "build_stderr": { "type": "string" },
        "test_command": { "$ref": "#/$defs/command" },
        "test_exit_status": { "type": ["integer", "null"] },
        "test_timed_out": { "type": "boolean" },
        "test_stdout": { "type": "string" },
        "test_stderr": { "type": "string" },
        "selected_test_failed": { "type": "boolean" },
        "result": { "enum": ["caught", "survived", "unviable", "timeout", "harness_failure"] }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id", "discovery_id", "status", "code_ids", "invariant_ids",
        "blockers", "baseline", "mutations"
      ],
      "properties": {
        "test_id": { "type": "string", "pattern": "^TEST_[A-Z0-9_]+$" },
        "discovery_id": { "type": "string", "pattern": "^DISC_[A-F0-9]{20}$" },
        "status": { "enum": ["open", "proven"] },
        "code_ids": { "$ref": "#/$defs/stringArray" },
        "invariant_ids": { "$ref": "#/$defs/stringArray" },
        "blockers": { "$ref": "#/$defs/stringArray" },
        "baseline": { "$ref": "#/$defs/baseline" },
        "mutations": {
          "type": "array",
          "items": { "$ref": "#/$defs/mutation" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denominator", "proven", "debt", "executed_tests", "caught_mutants",
        "survived_mutants", "unviable_mutants", "timeouts", "harness_failures"
      ],
      "properties": {
        "denominator": { "type": "integer", "minimum": 0 },
        "proven": { "type": "integer", "minimum": 0 },
        "debt": { "type": "integer", "minimum": 0 },
        "executed_tests": { "type": "integer", "minimum": 0 },
        "caught_mutants": { "type": "integer", "minimum": 0 },
        "survived_mutants": { "type": "integer", "minimum": 0 },
        "unviable_mutants": { "type": "integer", "minimum": 0 },
        "timeouts": { "type": "integer", "minimum": 0 },
        "harness_failures": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
