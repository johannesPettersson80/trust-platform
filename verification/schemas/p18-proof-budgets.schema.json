{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/p18-proof-budgets.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "source_sha", "input_closure_sha256", "state", "last_reviewed", "budgets"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"const": "P18_PROOF_BUDGETS_V1"},
    "source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "input_closure_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "state": {"enum": ["open", "frozen"]},
    "last_reviewed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "budgets": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/budget"}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "proof_class", "owner", "review_status", "tool", "tool_version", "environment", "topology", "seed", "input_digest", "shards", "baseline_iterations", "current_iterations", "baseline_duration_seconds", "current_duration_seconds", "baseline_obligation", "current_obligation", "last_reviewed"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "proof_class": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}, "review_status": {"enum": ["unreviewed", "accepted"]},
        "tool": {"type": "string", "minLength": 1}, "tool_version": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1}, "topology": {"type": "string", "minLength": 1},
        "seed": {"type": "string", "minLength": 1}, "input_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "shards": {"$ref": "#/$defs/count"}, "baseline_iterations": {"$ref": "#/$defs/count"},
        "current_iterations": {"$ref": "#/$defs/count"}, "baseline_duration_seconds": {"$ref": "#/$defs/count"},
        "current_duration_seconds": {"$ref": "#/$defs/count"}, "baseline_obligation": {"$ref": "#/$defs/count"},
        "current_obligation": {"$ref": "#/$defs/count"},
        "last_reviewed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    }
  }
}
