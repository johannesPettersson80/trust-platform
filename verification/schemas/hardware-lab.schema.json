{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/hardware-lab.schema.json",
  "title": "truST hardware-lab program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "owner", "status", "last_reviewed", "suite_id",
    "entrypoint_script", "workflow_path", "rust_harness_path", "gpio_script_path",
    "hardware_claim_spec_source_id", "public_claim_status", "strict_opt_in",
    "artifact_contract", "cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "const": "HARDWARE_LAB_PROGRAM_001" },
    "owner": { "const": "verification" },
    "status": { "const": "mapped" },
    "last_reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "suite_id": { "const": "hardware_lab" },
    "entrypoint_script": { "const": "scripts/runtime_device_in_loop_gate.sh" },
    "workflow_path": { "const": ".github/workflows/protocol-device-in-loop.yml" },
    "rust_harness_path": { "const": "crates/trust-runtime/tests/device_in_the_loop.rs" },
    "gpio_script_path": { "const": "scripts/gpio_hardware_test.sh" },
    "hardware_claim_spec_source_id": { "const": "SPEC_RELEASE_EVIDENCE_001" },
    "public_claim_status": { "const": "preview_unverified" },
    "strict_opt_in": { "const": "TRUST_DIT_REQUIRE_HARDWARE=1" },
    "artifact_contract": { "const": "target/gate-artifacts/device-in-the-loop/*.json" },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "board_row", "protocol", "title", "owner", "binding_kind",
        "ignored_test_ids", "command", "required_env_vars", "topology", "topology_ref",
        "artifact_paths", "assertions", "proof_status", "evidence_ids",
        "public_claim_impact"
      ],
      "properties": {
        "id": { "enum": ["LAB_MODBUS_TCP_001", "LAB_MQTT_BROKER_001", "LAB_ADS_TWINCAT_001", "LAB_ETHERCAT_DISCOVERY_001", "LAB_ETHERCAT_STORAGE_001", "LAB_GPIO_OUTPUT_001"] },
        "board_row": { "pattern": "^VERIF-P11-00[2-6]$" },
        "protocol": { "enum": ["modbus_tcp", "mqtt", "ads_twincat", "ethercat", "gpio"] },
        "title": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "binding_kind": { "enum": ["strict_harness", "manual_script"] },
        "ignored_test_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^IGNORED_[A-Z0-9_]+$" } },
        "command": { "type": "string", "minLength": 1 },
        "required_env_vars": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
        "topology": { "type": "string", "minLength": 1 },
        "topology_ref": { "type": "string", "minLength": 1 },
        "artifact_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "assertions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "proof_status": { "const": "skipped_unproven" },
        "evidence_ids": { "type": "array", "maxItems": 0 },
        "public_claim_impact": { "type": "string", "minLength": 1 }
      }
    }
  }
}
