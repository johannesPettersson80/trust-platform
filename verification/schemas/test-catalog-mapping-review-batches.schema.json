{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/test-catalog-mapping-review-batches.schema.json",
  "title": "Generated semantic mapping review batch manifest",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "generator_version",
    "source_commit",
    "proposal_queue_digest",
    "max_batch_size",
    "proposal_count",
    "semantic_group_count",
    "batch_count",
    "batches"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generator": { "const": "test-catalog-mapping-review-batches" },
    "generator_version": { "const": "1" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "proposal_queue_digest": { "$ref": "#/$defs/digest" },
    "max_batch_size": { "type": "integer", "minimum": 1 },
    "proposal_count": { "type": "integer", "minimum": 0 },
    "semantic_group_count": { "type": "integer", "minimum": 0 },
    "batch_count": { "type": "integer", "minimum": 0 },
    "batches": {
      "type": "array",
      "items": { "$ref": "#/$defs/batch" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "positive_indices": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "batch": {
      "type": "object",
      "required": [
        "batch_index",
        "semantic_group_index",
        "candidate_tier",
        "invariant_ids",
        "behavior_refs",
        "proposal_indices",
        "proposal_count",
        "json_file",
        "markdown_file"
      ],
      "properties": {
        "batch_index": { "type": "integer", "minimum": 1 },
        "semantic_group_index": { "type": "integer", "minimum": 1 },
        "candidate_tier": { "enum": ["C1", "C2", "C3"] },
        "invariant_ids": { "$ref": "#/$defs/strings" },
        "behavior_refs": { "$ref": "#/$defs/strings" },
        "proposal_indices": { "$ref": "#/$defs/positive_indices" },
        "proposal_count": { "type": "integer", "minimum": 1 },
        "json_file": {
          "type": "string",
          "pattern": "^batch-[0-9]{3}\\.json$"
        },
        "markdown_file": {
          "type": "string",
          "pattern": "^batch-[0-9]{3}\\.md$"
        }
      },
      "additionalProperties": false
    }
  }
}
