{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/catalog.schema.json",
  "title": "truST verification test catalog record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "subject_kind",
    "test_class",
    "area",
    "path",
    "command",
    "owner",
    "status",
    "invariants",
    "expected_result",
    "suite_tiers",
    "requires_hardware",
    "requires_network",
    "duration_class",
    "expected_failure_mode",
    "evidence_destination",
    "last_reviewed"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string" },
    "subject_kind": {
      "enum": ["generated_test", "case_table_artifact", "mutation_shard_runner"]
    },
    "discovery_id": { "type": "string", "pattern": "^DISC_[A-F0-9]{20}$" },
    "discovery_source_kind": {
      "enum": [
        "rust_integration_test",
        "rust_unit_test",
        "structured_text_test",
        "vscode_test",
        "conformance_case",
        "fuzz_target",
        "gate_script",
        "github_workflow_job"
      ]
    },
    "name": { "type": "string" },
    "malformed_input_class_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    },
    "test_class": {
      "enum": [
        "debug_reproduction_probe",
        "failing_regression",
        "protective_red",
        "behavior_lock",
        "unit",
        "integration",
        "runtime_vertical",
        "iec_conformance",
        "negative_malformed_input",
        "fuzz",
        "property",
        "mutation",
        "miri_sanitizer_loom",
        "protocol_loopback",
        "hardware_lab",
        "soak_stability",
        "performance",
        "lsp_protocol",
        "vscode_extension",
        "browser_webview_visual",
        "ui_journey_acceptance",
        "rbac_security",
        "supply_chain_security",
        "platform_package",
        "release_docs",
        "architecture_diagram",
        "metadata_validation"
      ]
    },
    "invariants": { "type": "array", "items": { "type": "string" } },
    "suite_tiers": { "type": "array", "items": { "type": "string" } },
    "case_file": { "type": "string" },
    "case_file_digest": { "type": "string" },
    "mutation_shard_id": { "type": "string" },
    "mutation_runner": { "type": "string" },
    "mutation_tool": { "type": "string" },
    "mutation_case_semantics": {
      "const": "association_only_case_ids_not_executed_by_mutation_runner"
    },
    "mutation_out_of_scope_case_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "mapping_assertion_source_digests": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "mutations": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": true
}
