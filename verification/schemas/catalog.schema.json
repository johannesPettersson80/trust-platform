{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/catalog.schema.json",
  "title": "truST verification test catalog record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "test_class",
    "area",
    "path",
    "command",
    "owner",
    "status",
    "invariants",
    "expected_result",
    "suite_tiers",
    "requires_hardware",
    "requires_network",
    "duration_class"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string" },
    "test_class": {
      "enum": [
        "debug_reproduction_probe",
        "failing_regression",
        "protective_red",
        "behavior_lock",
        "unit",
        "integration",
        "runtime_vertical",
        "iec_conformance",
        "negative_malformed_input",
        "fuzz",
        "property",
        "mutation",
        "miri_sanitizer_loom",
        "protocol_loopback",
        "hardware_lab",
        "soak_stability",
        "performance",
        "lsp_protocol",
        "vscode_extension",
        "browser_webview_visual",
        "ui_journey_acceptance",
        "rbac_security",
        "supply_chain_security",
        "platform_package",
        "release_docs",
        "architecture_diagram",
        "metadata_validation"
      ]
    },
    "invariants": { "type": "array", "items": { "type": "string" } },
    "suite_tiers": { "type": "array", "items": { "type": "string" } },
    "case_file": { "type": "string" },
    "case_file_digest": { "type": "string" },
    "mutation_shard_id": { "type": "string" },
    "mutation_runner": { "type": "string" },
    "mutation_tool": { "type": "string" },
    "mutation_case_semantics": {
      "const": "association_only_blocked_cases_not_executed"
    },
    "mutation_out_of_scope_case_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "mutations": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": true
}
