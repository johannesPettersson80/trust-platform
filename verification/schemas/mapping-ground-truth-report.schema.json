{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/mapping-ground-truth-report.schema.json",
  "title": "Execution-guided mapping ground-truth qualification",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "generator_version",
    "source_commit",
    "candidate_report_digest",
    "pilot_review_digest",
    "candidate_signals",
    "non_ground_truth_candidate_ids",
    "pilot_candidates",
    "zero_false_candidates",
    "exact_candidates",
    "candidate_results",
    "reviewed_acceptances",
    "zero_false_accepted_mappings",
    "exact_accepted_mappings",
    "accepted_results",
    "creates_catalog_mappings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generator": { "const": "mapping-ground-truth-pilot" },
    "generator_version": { "type": "string", "minLength": 1 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_report_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pilot_review_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_signals": { "type": "integer", "minimum": 1 },
    "non_ground_truth_candidate_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DISC_[A-F0-9]{20}$" },
      "uniqueItems": true
    },
    "pilot_candidates": { "type": "integer", "minimum": 1 },
    "zero_false_candidates": { "type": "boolean" },
    "exact_candidates": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DISC_[A-F0-9]{20}$" },
      "uniqueItems": true
    },
    "candidate_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate_result" }
    },
    "reviewed_acceptances": { "type": "integer", "minimum": 0 },
    "zero_false_accepted_mappings": { "type": "boolean" },
    "exact_accepted_mappings": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DISC_[A-F0-9]{20}$" },
      "uniqueItems": true
    },
    "accepted_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/accepted_result" }
    },
    "creates_catalog_mappings": { "const": false }
  },
  "additionalProperties": false,
  "$defs": {
    "invariant_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      },
      "uniqueItems": true
    },
    "candidate_result": {
        "type": "object",
        "required": [
          "discovery_id",
          "candidate_invariant_ids",
          "expected_invariant_ids",
          "false_invariant_ids",
          "missed_invariant_ids",
          "exact"
        ],
        "properties": {
          "discovery_id": {
            "type": "string",
            "pattern": "^DISC_[A-F0-9]{20}$"
          },
          "candidate_invariant_ids": { "$ref": "#/$defs/invariant_ids" },
          "expected_invariant_ids": { "$ref": "#/$defs/invariant_ids" },
          "false_invariant_ids": { "$ref": "#/$defs/invariant_ids" },
          "missed_invariant_ids": { "$ref": "#/$defs/invariant_ids" },
          "exact": { "type": "boolean" }
        },
        "additionalProperties": false
    },
    "accepted_result": {
      "type": "object",
      "required": [
        "discovery_id",
        "selected_invariant_ids",
        "expected_invariant_ids",
        "false_invariant_ids",
        "missed_invariant_ids",
        "exact"
      ],
      "properties": {
        "discovery_id": {
          "type": "string",
          "pattern": "^DISC_[A-F0-9]{20}$"
        },
        "selected_invariant_ids": { "$ref": "#/$defs/invariant_ids" },
        "expected_invariant_ids": { "$ref": "#/$defs/invariant_ids" },
        "false_invariant_ids": { "$ref": "#/$defs/invariant_ids" },
        "missed_invariant_ids": { "$ref": "#/$defs/invariant_ids" },
        "exact": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
