{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/p18-claim-matrix.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "source_sha", "input_closure_sha256", "state", "last_reviewed", "claims"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"const": "P18_CLAIM_MATRIX_V1"},
    "source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "input_closure_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "state": {"enum": ["open", "frozen"]},
    "last_reviewed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_ref", "owner", "status", "operating_systems", "architectures", "features", "profiles", "packaging_obligations", "locale_path_encoding", "evidence_requirements", "evidence_refs", "retirement_decision"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}, "status": {"enum": ["open", "closed", "retired"]},
        "operating_systems": {"$ref": "#/$defs/strings"}, "architectures": {"$ref": "#/$defs/strings"},
        "features": {"$ref": "#/$defs/strings"}, "profiles": {"$ref": "#/$defs/strings"},
        "packaging_obligations": {"$ref": "#/$defs/strings"}, "locale_path_encoding": {"$ref": "#/$defs/strings"},
        "evidence_requirements": {"$ref": "#/$defs/strings"}, "evidence_refs": {"$ref": "#/$defs/strings"},
        "retirement_decision": {"type": "string"}
      }
    },
    "strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
