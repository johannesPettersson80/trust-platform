{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/test-catalog-mapping-decisions.schema.json",
  "title": "Reviewed test-catalog mapping decisions",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "generator_version",
    "source_commit",
    "proposal_snapshots",
    "decisions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generator": { "const": "test-catalog-mapping-review" },
    "generator_version": { "type": "string", "minLength": 1 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "proposal_snapshots": {
      "type": "array",
      "items": { "type": "object" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "strings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "confirmed_catalog": {
      "type": "object",
      "required": [
        "test_class",
        "area",
        "owner",
        "expected_result",
        "expected_failure_mode",
        "suite_tiers",
        "requires_hardware",
        "requires_network",
        "duration_class"
      ],
      "properties": {
        "test_class": { "type": "string", "minLength": 1 },
        "area": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "expected_result": { "type": "string", "minLength": 1 },
        "expected_failure_mode": { "type": "string", "minLength": 1 },
        "suite_tiers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "requires_hardware": { "type": "boolean" },
        "requires_network": { "type": "boolean" },
        "duration_class": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "proposal_id",
        "proposal_digest",
        "discovery_id",
        "outcome",
        "reviewer_ids",
        "reviewed_source_digest",
        "assertion_reviews",
        "selected_invariant_ids",
        "selected_behavior_refs",
        "command",
        "command_authority"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "type": "string", "pattern": "^MAP_DEC_[A-F0-9]{24}$" },
        "proposal_id": { "type": "string", "pattern": "^MAP_CAND_[A-F0-9_]+$" },
        "proposal_digest": { "$ref": "#/$defs/digest" },
        "discovery_id": { "type": "string", "pattern": "^DISC_[A-F0-9]{20}$" },
        "outcome": { "enum": ["accepted", "rejected"] },
        "reviewer_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "reviewed_source_digest": { "$ref": "#/$defs/digest" },
        "assertion_reviews": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion_review" }
        },
        "selected_invariant_ids": { "$ref": "#/$defs/strings" },
        "selected_behavior_refs": { "$ref": "#/$defs/strings" },
        "command": { "type": "string" },
        "command_authority": {
          "enum": ["verified_exact", "not_applicable"]
        },
        "confirmed_catalog": {
          "oneOf": [
            { "$ref": "#/$defs/confirmed_catalog" },
            { "type": "null" }
          ]
        },
        "rejection_reason": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "assertion_review": {
      "type": "object",
      "required": [
        "assertion_id",
        "disposition",
        "behavior_refs",
        "rationale"
      ],
      "properties": {
        "assertion_id": {
          "type": "string",
          "pattern": "^ASSERT_[A-F0-9]{24}$"
        },
        "disposition": {
          "enum": [
            "oracle_bound",
            "setup_or_precondition",
            "non_oracle"
          ]
        },
        "behavior_refs": { "$ref": "#/$defs/strings" },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
