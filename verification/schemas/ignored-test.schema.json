{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/ignored-test.schema.json",
  "title": "truST ignored-test registry record",
  "type": "object",
  "required": [
    "area",
    "discovery_id",
    "discovery_source_kind",
    "id",
    "ignore_class",
    "ignore_mechanism",
    "ignore_reason",
    "ignore_state",
    "last_reviewed",
    "name",
    "owner",
    "path",
    "reason",
    "schema_version",
    "status",
    "unblock_condition"
  ],
  "properties": {
    "area": {
      "enum": [
        "compiler_iec",
        "bytecode_vm",
        "runtime_safety",
        "protocols",
        "control_security",
        "editor_safety",
        "plcopen_devtools",
        "hmi_ui",
        "release",
        "supply_chain_platform",
        "verification"
      ]
    },
    "discovery_id": { "type": "string", "pattern": "^DISC_[A-F0-9]{20}$" },
    "discovery_source_kind": {
      "enum": [
        "rust_integration_test",
        "rust_unit_test",
        "vscode_test",
        "playwright_test"
      ]
    },
    "id": { "type": "string", "pattern": "^IGNORED_[A-Z0-9_]+$" },
    "test_id": { "type": "string", "pattern": "^TEST_[A-Z0-9_]+$" },
    "ignore_class": {
      "enum": [
        "red_protective",
        "lab_required",
        "perf_soak",
        "manual",
        "flaky_quarantined",
        "obsolete",
        "unknown"
      ]
    },
    "ignore_mechanism": {
      "enum": [
        "rust_attribute",
        "rust_cfg_attr",
        "vscode_runtime_skip",
        "playwright_literal_skip"
      ]
    },
    "ignore_reason": { "type": "string", "minLength": 1 },
    "ignore_state": { "enum": ["ignored", "conditional"] },
    "last_reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "name": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 2 },
    "status": {
      "enum": [
        "planned",
        "mapped",
        "gap_open",
        "spec_gap",
        "test_written",
        "implemented",
        "validated",
        "blocked",
        "deferred",
        "rejected",
        "unproven"
      ]
    },
    "unblock_condition": { "type": "string", "minLength": 1 },
    "linked_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "expected_red_symptom": { "type": "string", "minLength": 1 },
    "required_env_vars": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "uniqueItems": true
    },
    "hardware_topology": { "type": "string", "minLength": 1 },
    "hardware_topology_ref": { "type": "string", "minLength": 1 },
    "public_claim_impact": { "type": "string", "minLength": 1 },
    "last_observed_failure": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "failure_signature": { "type": "string", "minLength": 1 },
    "evidence_ref": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "ignore_class": { "const": "red_protective" } } },
      "then": { "required": ["linked_rows", "expected_red_symptom"] }
    },
    {
      "if": { "properties": { "ignore_class": { "const": "lab_required" } } },
      "then": {
        "required": [
          "required_env_vars",
          "hardware_topology",
          "hardware_topology_ref",
          "public_claim_impact"
        ]
      }
    },
    {
      "if": { "properties": { "ignore_class": { "const": "flaky_quarantined" } } },
      "then": {
        "required": ["last_observed_failure", "failure_signature", "evidence_ref"]
      }
    }
  ],
  "additionalProperties": false
}
