{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/release-evidence-manifest.schema.json",
  "title": "truST release evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "owner", "status", "last_reviewed", "spec_source_id",
    "release_branches", "version_sources", "changelog_path", "release_workflow_path",
    "ci_workflow_path", "security_policy_path", "required_release_assets", "proof_origins",
    "hardware_lab_rows", "security_policy", "latest_public_snapshot", "platforms"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "const": "RELEASE_EVIDENCE_MANIFEST_001" },
    "owner": { "const": "release" },
    "status": { "const": "mapped" },
    "last_reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "spec_source_id": { "const": "SPEC_RELEASE_EVIDENCE_001" },
    "release_branches": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["main", "master"] } },
    "version_sources": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "changelog_path": { "const": "CHANGELOG.md" },
    "release_workflow_path": { "const": ".github/workflows/release.yml" },
    "ci_workflow_path": { "const": ".github/workflows/ci.yml" },
    "security_policy_path": { "const": "deny.toml" },
    "required_release_assets": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "proof_origins": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["local", "remote_builder", "ci", "hardware_lab", "public_github"] } },
    "hardware_lab_rows": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "pattern": "^VERIF-P11-00[2-6]$" } },
    "security_policy": { "$ref": "#/$defs/security_policy" },
    "latest_public_snapshot": { "$ref": "#/$defs/public_snapshot" },
    "platforms": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/platform" } }
  },
  "$defs": {
    "security_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["exception_owner_required", "exception_expiry_required", "maximum_exception_days", "rust_commands", "node_commands"],
      "properties": {
        "exception_owner_required": { "const": true },
        "exception_expiry_required": { "const": true },
        "maximum_exception_days": { "const": 90 },
        "rust_commands": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "node_commands": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "const": "npm audit --audit-level=low" } }
      }
    },
    "public_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "checked_at", "tag", "commit", "published_at", "release_url", "workflow_run_id", "workflow_run_url", "workflow_conclusion", "assets"],
      "properties": {
        "status": { "const": "published_latest" },
        "checked_at": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "published_at": { "type": "string", "minLength": 1 },
        "release_url": { "type": "string", "pattern": "^https://github.com/" },
        "workflow_run_id": { "type": "string", "pattern": "^\\d+$" },
        "workflow_run_url": { "type": "string", "pattern": "^https://github.com/" },
        "workflow_conclusion": { "const": "success" },
        "assets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "target", "support_tier", "required_proof", "runtime_asset", "lsp_asset", "vsix_asset_template"],
      "properties": {
        "id": { "enum": ["linux-x64", "linux-arm64", "darwin-x64", "darwin-arm64", "win32-x64"] },
        "target": { "type": "string", "minLength": 1 },
        "support_tier": { "enum": ["native_ci", "artifact_only", "hardware_qualified", "unsupported"] },
        "required_proof": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["native_ci_test", "release_artifact", "sha256", "device_in_loop"] } },
        "runtime_asset": { "type": "string", "minLength": 1 },
        "lsp_asset": { "type": "string", "minLength": 1 },
        "vsix_asset_template": { "type": "string", "pattern": "\\{version\\}" }
      }
    }
  }
}
