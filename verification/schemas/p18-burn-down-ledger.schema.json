{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-plc.local/schemas/p18-burn-down-ledger.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator", "generator_version", "source_sha", "input_digest", "input_paths", "status", "historical_baseline", "slice_policy", "summary", "code_slices", "test_slices"],
  "properties": {
    "schema_version": {"const": 1},
    "generator": {"const": "p18-burn-down-ledger"},
    "generator_version": {"const": 1},
    "source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "input_digest": {"$ref": "#/$defs/digest"},
    "input_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"const": "frozen_open"},
    "historical_baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["code_facts", "spec_gap", "test_facts", "reviewed_nonmapping"],
      "properties": {
        "code_facts": {"const": 15229}, "spec_gap": {"const": 15138},
        "test_facts": {"const": 4038}, "reviewed_nonmapping": {"const": 3777}
      }
    },
    "slice_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["code_grouping", "test_grouping", "semantic_inference", "unresolved_test_area_owner", "area_order", "code_dependency_order", "test_dependency_order"],
      "properties": {
        "code_grouping": {"const": "one_live_code_identity_per_slice"},
        "test_grouping": {"const": "one_live_test_identity_per_slice"},
        "semantic_inference": {"const": false},
        "unresolved_test_area_owner": {"const": "verification"},
        "area_order": {"type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true, "items": {"$ref": "#/$defs/area"}},
        "code_dependency_order": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string"}},
        "test_dependency_order": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}}
      }
    },
    "summary": {"$ref": "#/$defs/summary"},
    "code_slices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/code_slice"}},
    "test_slices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test_slice"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "area": {"enum": ["bytecode_vm", "compiler_iec", "control_security", "editor_safety", "hmi_ui", "plcopen_devtools", "protocols", "release", "runtime_safety", "supply_chain_platform", "verification"]},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "nonempty_strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "area_count": {
      "type": "object", "additionalProperties": false,
      "required": ["area", "facts"],
      "properties": {"area": {"type": "string", "minLength": 1}, "facts": {"$ref": "#/$defs/count"}}
    },
    "code_area_count": {
      "type": "object", "additionalProperties": false,
      "required": ["area", "facts", "spec_gap", "registered_backlog"],
      "properties": {
        "area": {"$ref": "#/$defs/area"}, "facts": {"$ref": "#/$defs/count"},
        "spec_gap": {"$ref": "#/$defs/count"}, "registered_backlog": {"$ref": "#/$defs/count"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["code_facts", "test_facts", "code_spec_gap", "code_registered_backlog", "test_reviewed_nonmapping", "test_ignored_or_conditional", "unresolved_test_area", "unowned", "duplicate_identities", "omitted_identities", "code_by_area", "test_by_accounting_area"],
      "properties": {
        "code_facts": {"$ref": "#/$defs/count"}, "test_facts": {"$ref": "#/$defs/count"},
        "code_spec_gap": {"$ref": "#/$defs/count"}, "code_registered_backlog": {"$ref": "#/$defs/count"},
        "test_reviewed_nonmapping": {"$ref": "#/$defs/count"}, "test_ignored_or_conditional": {"$ref": "#/$defs/count"},
        "unresolved_test_area": {"$ref": "#/$defs/count"}, "unowned": {"const": 0},
        "duplicate_identities": {"const": 0}, "omitted_identities": {"const": 0},
        "code_by_area": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/code_area_count"}},
        "test_by_accounting_area": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/area_count"}}
      }
    },
    "code_slice": {
      "type": "object", "additionalProperties": false,
      "required": ["slice_id", "sequence", "code_id", "source_kind", "path", "qualified_symbol", "item_kind", "area", "owner", "risk_classes", "risk_signals", "current_disposition", "authority_refs", "decision_refs", "invariant_refs", "test_refs", "environment_refs", "budget_refs", "dependency_rows", "blockers", "status"],
      "properties": {
        "slice_id": {"type": "string", "pattern": "^P18-CODE-CODE_[A-F0-9]{64}$"},
        "sequence": {"type": "integer", "minimum": 1},
        "code_id": {"type": "string", "pattern": "^CODE_[A-F0-9]{64}$"},
        "source_kind": {"enum": ["rust", "typescript", "javascript", "python", "shell"]},
        "path": {"type": "string", "minLength": 1}, "qualified_symbol": {"type": "string", "minLength": 1},
        "item_kind": {"type": "string", "minLength": 1}, "area": {"$ref": "#/$defs/area"},
        "owner": {"type": "string", "minLength": 1}, "risk_classes": {"$ref": "#/$defs/nonempty_strings"},
        "risk_signals": {"$ref": "#/$defs/strings"}, "current_disposition": {"enum": ["specified", "spec_gap", "inherits_spec", "non_behavioral", "generated", "vendored_external"]},
        "authority_refs": {"$ref": "#/$defs/strings"}, "decision_refs": {"$ref": "#/$defs/strings"},
        "invariant_refs": {"$ref": "#/$defs/strings"}, "test_refs": {"$ref": "#/$defs/strings"},
        "environment_refs": {"$ref": "#/$defs/nonempty_strings"}, "budget_refs": {"$ref": "#/$defs/nonempty_strings"},
        "dependency_rows": {"$ref": "#/$defs/nonempty_strings"}, "blockers": {"$ref": "#/$defs/nonempty_strings"},
        "status": {"const": "open"}
      }
    },
    "test_slice": {
      "type": "object", "additionalProperties": false,
      "required": ["slice_id", "sequence", "discovery_id", "source_kind", "path", "name", "ignore_state", "accounting_area", "candidate_areas", "owner", "risk_classes", "current_disposition", "review_reason", "catalog_test_id", "authority_refs", "invariant_refs", "code_slice_refs", "environment_refs", "budget_refs", "dependency_rows", "blockers", "status"],
      "properties": {
        "slice_id": {"type": "string", "pattern": "^P18-TEST-DISC_[A-F0-9]{20}$"},
        "sequence": {"type": "integer", "minimum": 1},
        "discovery_id": {"type": "string", "pattern": "^DISC_[A-F0-9]{20}$"},
        "source_kind": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}, "ignore_state": {"enum": ["not_ignored", "ignored", "conditional"]},
        "accounting_area": {"type": "string", "minLength": 1},
        "candidate_areas": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/area"}},
        "owner": {"type": "string", "minLength": 1}, "risk_classes": {"$ref": "#/$defs/nonempty_strings"},
        "current_disposition": {"enum": ["catalog_mapped", "reviewed_nonmapping"]},
        "review_reason": {"type": "string", "minLength": 1}, "catalog_test_id": {"type": "string"},
        "authority_refs": {"$ref": "#/$defs/strings"}, "invariant_refs": {"$ref": "#/$defs/strings"},
        "code_slice_refs": {"$ref": "#/$defs/strings"}, "environment_refs": {"$ref": "#/$defs/nonempty_strings"},
        "budget_refs": {"$ref": "#/$defs/nonempty_strings"}, "dependency_rows": {"$ref": "#/$defs/nonempty_strings"},
        "blockers": {"$ref": "#/$defs/nonempty_strings"}, "status": {"const": "open"}
      }
    }
  }
}
