{"nodes":[{"id":"step_init","type":"step","position":{"x":300,"y":50},"data":{"label":"Init","type":"initial","actions":[{"id":"action_init","name":"InitSnake","qualifier":"N","body":"// Initialize 8-LED Snake System\nposition := 0;\ndirection := 1;\n// Turn off all LEDs\n%QX0.0 := FALSE;\n%QX0.1 := FALSE;\n%QX0.2 := FALSE;\n%QX0.3 := FALSE;\n%QX0.4 := FALSE;\n%QX0.5 := FALSE;\n%QX0.6 := FALSE;\n%QX0.7 := FALSE;"}]}},{"id":"step_running","type":"step","position":{"x":300,"y":200},"data":{"label":"Running","type":"normal","actions":[{"id":"action_update_position","name":"UpdatePosition","qualifier":"P1","body":"// Update snake position\nposition := position + direction;\n\n// Turn off all LEDs first\n%QX0.0 := FALSE;\n%QX0.1 := FALSE;\n%QX0.2 := FALSE;\n%QX0.3 := FALSE;\n%QX0.4 := FALSE;\n%QX0.5 := FALSE;\n%QX0.6 := FALSE;\n%QX0.7 := FALSE;\n\n// Turn on LED at current position\nCASE position OF\n  0: %QX0.0 := TRUE;\n  1: %QX0.1 := TRUE;\n  2: %QX0.2 := TRUE;\n  3: %QX0.3 := TRUE;\n  4: %QX0.4 := TRUE;\n  5: %QX0.5 := TRUE;\n  6: %QX0.6 := TRUE;\n  7: %QX0.7 := TRUE;\nEND_CASE;"},{"id":"action_check_bounds","name":"CheckBounds","qualifier":"P1","body":"// Check boundaries and reverse direction\nIF position >= 7 THEN\n  direction := -1;\nELSIF position <= 0 THEN\n  direction := 1;\nEND_IF;"}]}},{"id":"step_wait","type":"step","position":{"x":300,"y":350},"data":{"label":"Wait","type":"normal","actions":[{"id":"action_delay","name":"DelayTimer","qualifier":"L","body":"// Wait for next step","time":300}]}},{"id":"step_stopped","type":"step","position":{"x":300,"y":500},"data":{"label":"Stopped","type":"normal","actions":[{"id":"action_stop_all","name":"StopAll","qualifier":"N","body":"// Turn off all LEDs\n%QX0.0 := FALSE;\n%QX0.1 := FALSE;\n%QX0.2 := FALSE;\n%QX0.3 := FALSE;\n%QX0.4 := FALSE;\n%QX0.5 := FALSE;\n%QX0.6 := FALSE;\n%QX0.7 := FALSE;"}]}}],"edges":[{"id":"trans_init_to_running","source":"step_init","target":"step_running","type":"transition","data":{"condition":"start_button = TRUE AND stop_button = FALSE","label":"T_Start"},"label":"T_Start"},{"id":"trans_running_to_wait","source":"step_running","target":"step_wait","type":"transition","data":{"condition":"TRUE","label":"T_NextStep"},"label":"T_NextStep"},{"id":"trans_wait_to_running","source":"step_wait","target":"step_running","type":"transition","data":{"condition":"NOT DelayTimer.Q AND stop_button = FALSE","label":"T_DelayDone"},"label":"T_DelayDone"},{"id":"trans_wait_to_stopped","source":"step_wait","target":"step_stopped","type":"transition","data":{"condition":"stop_button = TRUE","label":"T_Stop"},"label":"T_Stop"},{"id":"trans_running_to_stopped","source":"step_running","target":"step_stopped","type":"transition","data":{"condition":"stop_button = TRUE","label":"T_EmergencyStop","priority":1},"label":"T_EmergencyStop"},{"id":"trans_stopped_to_init","source":"step_stopped","target":"step_init","type":"transition","data":{"condition":"reset_button = TRUE","label":"T_Reset"},"label":"T_Reset"}],"variables":[{"name":"position","type":"INT","initialValue":"0","comment":"Current LED position (0-7)"},{"name":"direction","type":"INT","initialValue":"1","comment":"Movement direction: 1 = forward, -1 = backward"},{"name":"start_button","type":"BOOL","initialValue":"FALSE","comment":"Button to start the snake"},{"name":"stop_button","type":"BOOL","initialValue":"FALSE","comment":"Button to stop the snake"},{"name":"reset_button","type":"BOOL","initialValue":"FALSE","comment":"Button to reset the snake"}]}