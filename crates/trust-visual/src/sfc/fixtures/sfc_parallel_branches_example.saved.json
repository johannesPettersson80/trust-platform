{
  "name": "SFC_Program",
  "steps": [
    {
      "id": "step_init",
      "name": "Init",
      "initial": true,
      "x": 300,
      "y": 50,
      "actions": [
        {
          "id": "act_init_1",
          "name": "InitSystem",
          "qualifier": "N",
          "body": "system_ready := TRUE;"
        }
      ]
    },
    {
      "id": "step_prepare",
      "name": "Prepare",
      "initial": false,
      "x": 300,
      "y": 150,
      "actions": [
        {
          "id": "act_prep_1",
          "name": "PrepareMaterials",
          "qualifier": "N",
          "body": "materials_ready := TRUE;"
        }
      ]
    },
    {
      "id": "step_heat",
      "name": "Heat",
      "initial": false,
      "x": 150,
      "y": 350,
      "actions": [
        {
          "id": "act_heat_1",
          "name": "HeatProcess",
          "qualifier": "L",
          "time": "T#2s",
          "body": "heater_on := HeatProcess.Q;\nIF HeatProcess.Q THEN\n  temperature := 150;\nEND_IF;"
        }
      ]
    },
    {
      "id": "step_mix",
      "name": "Mix",
      "initial": false,
      "x": 300,
      "y": 350,
      "actions": [
        {
          "id": "act_mix_1",
          "name": "MixIngredients",
          "qualifier": "L",
          "time": "T#3s",
          "body": "mixer_on := MixIngredients.Q;\nIF MixIngredients.Q THEN\n  mix_speed := 500;\nELSE\n  mix_speed := 0;\nEND_IF;"
        }
      ]
    },
    {
      "id": "step_polish",
      "name": "Polish",
      "initial": false,
      "x": 450,
      "y": 350,
      "actions": [
        {
          "id": "act_polish_1",
          "name": "PolishSurface",
          "qualifier": "L",
          "time": "T#1500ms",
          "body": "polisher_on := PolishSurface.Q;\nIF PolishSurface.Q THEN\n  polish_level := 100;\nEND_IF;"
        }
      ]
    },
    {
      "id": "step_finish",
      "name": "Finish",
      "initial": false,
      "x": 300,
      "y": 550,
      "actions": [
        {
          "id": "act_finish_1",
          "name": "CompleteProcess",
          "qualifier": "N",
          "body": "process_complete := TRUE;"
        }
      ]
    }
  ],
  "transitions": [
    {
      "id": "trans_init_prepare",
      "name": "T1_Start",
      "condition": "system_ready",
      "sourceStepId": "step_init",
      "targetStepId": "step_prepare",
      "priority": 1
    },
    {
      "id": "trans_prepare_split",
      "name": "T2_ToSplit",
      "condition": "materials_ready",
      "sourceStepId": "step_prepare",
      "targetStepId": "split_parallel",
      "priority": 1
    },
    {
      "id": "trans_split_heat",
      "name": "T3_ToHeat",
