{
  "actions": [
    {
      "confirm": {
        "cancel": "Cancel",
        "confirm": "Search",
        "text": "EtherCAT scans the SubDevices on the adapter of the project's EtherCAT driver. It reads each SubDevice's identity in PRE-OP with its process data mapped, and it never brings the bus to SAFE-OP or OP. It can disturb a live bus."
      },
      "emphasis": "primary",
      "enabled": true,
      "id": "search",
      "label": "Search",
      "op": {
        "kind": "search",
        "request": {
          "origin": {
            "runtime": "runtime:old"
          },
          "params": {
            "confirm_fieldbus_scan": true,
            "only": [
              "trust_runtime",
              "ads",
              "modbus_tcp",
              "mqtt",
              "opcua",
              "ethercat",
              "gpio",
              "serial",
              "usb"
            ]
          },
          "verb": "start"
        }
      }
    },
    {
      "emphasis": "secondary",
      "enabled": true,
      "id": "configure_ads_ports",
      "label": "Configure ADS ports to scan",
      "op": {
        "effect": {
          "kind": "open_settings",
          "query": "trust.ads.discoveryPorts"
        },
        "kind": "host"
      }
    }
  ],
