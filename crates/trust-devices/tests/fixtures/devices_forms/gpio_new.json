          "id": "backend",
          "label": "Backend",
          "required": true,
          "required_mark": " *",
          "kind": "choice",
          "value": "libgpiod",
          "options": [
            {
              "value": "libgpiod",
              "label": "libgpiod"
            },
            {
              "value": "sysfs",
              "label": "sysfs"
            }
          ],
          "help": "Linux GPIO access backend. libgpiod uses the kernel GPIO character device; sysfs is available for legacy hosts.",
          "forget_after_post": false
        },
        {
          "id": "chip",
          "label": "GPIO chip",
          "required": false,
          "kind": "text",
          "value": "/dev/gpiochip0",
          "options": [],
