            "field": "backend",
            "equals": "libgpiod"
          },
          "forget_after_post": false
        },
        {
          "id": "sysfs_base",
          "label": "Sysfs base",
          "required": false,
          "kind": "text",
          "value": "/sys/class/gpio",
          "options": [],
          "help": "Legacy sysfs root, usually /sys/class/gpio. Only used when Backend is sysfs.",
