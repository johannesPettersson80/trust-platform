{
  "id": "mqtt@runtime:local",
  "protocol": "mqtt",
  "title": "Add MQTT",
  "breadcrumb": "Devices & Connections / Add device or connection",
  "owner_line": "on Simulator",
  "purpose": "Publish and subscribe process I/O through a broker.",
  "runtime": {
    "id": "runtime:local",
    "name": "Simulator"
  },
  "runtime_choices": [
    {
      "id": "runtime:local",
      "name": "Simulator",
      "action": {
        "id": "runtime:local",
        "label": "Simulator",
        "enabled": true,
        "emphasis": "secondary",
        "op": {
          "kind": "rust",
          "action": "form.open",
          "payload": {
            "form": "mqtt@runtime:local",
            "protocol": "mqtt",
            "runtime": "runtime:local"
          }
        }
      }
    }
  ],
  "sections": [
    {
      "fields": [
        {
          "id": "broker",
          "label": "Broker",
          "required": true,
          "kind": "text",
          "value": "127.0.0.1:1883",
          "options": [],
          "help": "MQTT broker host and port."
        },
        {
          "id": "client_id",
          "label": "Client ID",
          "required": false,
          "kind": "text",
          "value": "",
          "options": [],
          "help": "Optional MQTT client id. Empty lets the runtime choose one."
        },
        {
          "id": "topic_in",
          "label": "Input topic",
          "required": true,
          "kind": "text",
          "value": "trust/io/in",
          "options": [],
          "help": "Topic used for incoming process values."
        },
        {
          "id": "topic_out",
          "label": "Output topic",
          "required": true,
          "kind": "text",
          "value": "trust/io/out",
          "options": [],
          "help": "Topic used for outgoing process values."
        },
        {
          "id": "username",
          "label": "Username",
          "required": false,
          "kind": "text",
          "value": "",
          "options": [],
          "help": "Broker username. Use together with password."
        },
        {
          "id": "password",
          "label": "Password",
          "required": false,
          "kind": "secret",
          "value": null,
          "options": [],
          "help": "Broker password. Existing saved passwords are not shown here."
        },
        {
          "id": "tls",
          "label": "TLS",
          "required": false,
          "kind": "boolean",
          "value": false,
          "options": [],
          "help": "Use TLS for the MQTT connection."
        },
        {
          "id": "allow_insecure_remote",
          "label": "Allow insecure remote broker",
          "required": false,
          "kind": "boolean",
          "value": false,
          "options": [],
          "help": "Required when using a non-TLS broker that is not local."
        },
        {
          "id": "reconnect_ms",
          "label": "Reconnect delay",
          "required": true,
          "kind": "number",
          "value": 500,
          "options": [],
          "help": "Delay between reconnect attempts in milliseconds."
        },
        {
          "id": "keep_alive_s",
          "label": "Keepalive",
          "required": true,
          "kind": "number",
          "value": 5,
          "options": [],
          "help": "MQTT keepalive in seconds."
        },
        {
          "id": "on_error",
          "label": "On error",
          "required": true,
          "kind": "choice",
          "value": "fault",
          "options": [
            {
              "value": "fault",
              "label": "Stop with fault"
            },
            {
              "value": "warn",
              "label": "Warn and continue"
            },
            {
              "value": "ignore",
              "label": "Ignore"
            }
          ],
          "help": "Runtime behavior when the MQTT broker is unreachable or no fresh message is available."
        }
      ]
    },
    {
      "heading": "Advanced",
      "fields": [
        {
          "id": "tls_ca_path",
          "label": "TLS CA path",
          "required": false,
          "kind": "text",
          "value": "",
          "options": [],
          "help": "CA certificate path when TLS is enabled."
        },
        {
          "id": "tls_client_cert_path",
          "label": "Client cert path",
          "required": false,
          "kind": "text",
          "value": "",
          "options": [],
          "help": "Client certificate path for mTLS."
        },
        {
          "id": "tls_client_key_path",
          "label": "Client key path",
          "required": false,
          "kind": "text",
          "value": "",
          "options": [],
          "help": "Client key path for mTLS."
        },
        {
          "id": "tls_alpn",
          "label": "TLS ALPN",
          "required": false,
          "kind": "list",
          "value": [],
          "options": [],
          "help": "Optional ALPN protocol list.",
          "list": {
            "item_noun": "TLS ALPN",
            "item_title": "TLS ALPN",
            "add_label": "Add TLS ALPN",
            "empty_text": "No TLS ALPN yet. Add an item below.",
            "can_add": true,
            "item_kind": "text",
            "item_template": "",
            "properties": []
          }
        }
      ]
    }
  ],
  "buttons": [
    {
      "id": "save",
      "label": "Save",
      "enabled": true,
      "emphasis": "primary",
      "op": {
        "kind": "rust",
        "action": "connection.save",
        "payload": {
          "form": "mqtt@runtime:local",
          "protocol": "mqtt",
          "runtime": "runtime:local"
        }
      }
    },
    {
      "id": "cancel",
      "label": "Cancel",
      "enabled": true,
      "emphasis": "secondary",
      "op": {
        "kind": "ui",
        "ui": {
          "kind": "close_inspector"
        }
      }
    },
    {
      "id": "test",
      "label": "Test",
      "enabled": true,
      "emphasis": "secondary",
      "op": {
        "kind": "rust",
        "action": "connection.test",
        "payload": {
          "form": "mqtt@runtime:local",
          "protocol": "mqtt",
          "runtime": "runtime:local"
        }
      }
    },
    {
      "id": "apply_live",
      "label": "Apply to running runtime",
      "enabled": true,
      "emphasis": "secondary",
      "op": {
        "kind": "rust",
        "action": "connection.apply_live",
        "payload": {
          "form": "mqtt@runtime:local",
          "protocol": "mqtt",
          "runtime": "runtime:local"
        }
      }
    }
  ],
  "ghost": {
    "name": "New device",
    "detail": "Draft: configure and Apply"
  }
}
