          "required": false,
          "kind": "boolean",
          "value": true,
          "options": [],
          "help": "Expose selected truST globals over ADS.",
          "forget_after_post": false
        },
        {
          "id": "listen",
          "label": "Listen IP",
          "required": true,
          "required_mark": " *",
          "kind": "text",
          "value": "127.0.0.1",
          "options": [],
          "help": "Local IP address where TwinCAT/ADS clients connect. Wildcard binds are rejected.",
          "forget_after_post": false
        },
        {
          "id": "ams_net_id",
          "label": "AMS Net ID",
          "required": false,
          "kind": "text",
          "value": "",
          "options": [],
          "help": "Runtime AMS Net ID. Empty derives it from an IPv4 listen address.",
          "forget_after_post": false
        },
        {
          "id": "ads_port",
          "label": "ADS port",
          "required": true,
          "required_mark": " *",
          "kind": "number",
          "value": 851,
          "options": [],
          "help": "Logical ADS port.",
          "forget_after_post": false
        },
        {
          "id": "insecure_transport",
          "label": "Plain ADS transport",
          "required": false,
          "kind": "boolean",
          "value": true,
          "options": [],
          "help": "Required acknowledgement for plain ADS server transport.",
          "forget_after_post": false
