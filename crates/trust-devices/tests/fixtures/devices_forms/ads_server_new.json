              },
              {
                "key": "source_cidr",
                "label": "Source CIDR",
                "kind": "text",
                "required": false,
                "options": [],
                "alternatives": [
                  "source_ip"
                ]
              }
            ]
          },
          "forget_after_post": false
        }
      ]
