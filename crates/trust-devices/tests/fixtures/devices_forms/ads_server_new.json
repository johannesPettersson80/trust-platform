{
  "id": "ads_server@runtime:local",
  "protocol": "ads_server",
  "title": "Add ADS server",
  "breadcrumb": "Devices & Connections / Add device or connection",
  "owner_line": "on Simulator",
  "purpose": "Expose selected truST globals to TwinCAT or ADS clients.",
  "runtime": {
    "id": "runtime:local",
    "name": "Simulator"
  },
  "runtime_choices": [
    {
      "id": "runtime:local",
      "name": "Simulator",
      "action": {
        "id": "runtime:local",
        "label": "Simulator",
        "enabled": true,
        "emphasis": "secondary",
        "op": {
          "kind": "rust",
          "action": "form.open",
          "payload": {
            "form": "ads_server@runtime:local",
            "protocol": "ads_server",
            "runtime": "runtime:local"
          }
        }
      }
    }
  ],
