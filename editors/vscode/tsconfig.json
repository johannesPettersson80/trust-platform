{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": [
      "ES2020"
    ],
    "types": [
      "node",
      "mocha"
    ],
    "rootDir": "src",
    "outDir": "out",
    "moduleResolution": "Node16",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "src/statechart/webview/**",
    "src/blockly/webview/**",
    "src/ladder/webview/**",
    "src/sfc/webview/**",
    "src/networkCanvas/webview/**",
    "src/visual/runtime/webview/**"
  ]
}
