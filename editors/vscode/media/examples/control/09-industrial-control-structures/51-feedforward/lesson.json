  "learning": {
    "context": "Three equivalent continuous conveyor ovens expose separate heater and measured production-speed paths around a 120-degC operating point.",
    "reason": "The previous qualified feedback workflow still showed load error because feedback cannot act until its process value changes; measured speed is available earlier.",
    "theory": [
      "Feedback reacts to temperature error while feedforward predicts temperature change from measured conveyor speed.",
      "Static feedforward cancels steady path gain; dynamic feedforward also compensates the different path time constants.",
      "Feedforward enters Control.PID before its limits and anti-windup, retains PI trim, and loses authority when disturbance data are invalid."
    ],
    "workedPrediction": "A speed step from 1.0 to 2.0 requests no immediate feedback correction, 10 percentage points of static feedforward, and 25 percentage points of initial dynamic feedforward decaying to 10.",
    "practicalPreparation": [
      "Verify Simulation evidence, three equivalent plant and controller identities, SP/PV/MV units, actual and measured speed, quality, 0.1-s timing, limits and operating point.",
      "Define and record event IAE, peak deviation, applied-heater movement and settling rules before revealing the traces."
    ],
    "baseline": "Run feedback-only PI through the identical speed disturbance and retain the temperature error it cannot prevent.",
    "change": "Compare static gain compensation and dynamic gain-and-timing compensation, then change only the dynamic scale to 0.8 and separately invalidate measured speed.",
    "comparison": "Hold every plant, controller, event, timing, limit and metric window equal while changing only feedforward structure or declared scale.",
    "validation": "Require finite bounded unsaturated runs, ordered nominal event IAE, predicted feedforward endpoints, PI recovery under mismatch and visible feedback-only fallback for invalid speed.",
    "explanation": "Dynamic feedforward moves farther initially because the heater path is slower than the disturbance path; feedback removes residual error when the model is imperfect.",
    "transfer": "Lesson 52 continues with Cascade."
  }
