Characterized mapping,Cooling,962,96.PPER = str.maketrans(string.ascii_lowercase, string.ascii_uppercase)\n\n\ndef printable_code(code: int) -> bool:\n    return type(code) is int and 4 <= code <= 63\n\n\ndef encode_text(text: str) -> tuple[int, ...]:\n    if not isinstance(text, str) or not text.isascii():\n        raise ValueError(\"text must contain supported ASCII characters\")\n    try:\n        return tuple(CHAR_TO_CODE[char] for char in text.translate(ASCII_UPPER))\n    except KeyError as error:\n        raise ValueError(f\"unsupported character: {error.args[0]!r}\") from None\n\n\ndef decode_text(codes: Iterable[int]) -> str:\n    chars = []\n    for code in codes:\n        if not printable_code(code):\n            raise ValueError(f\"nonprintable character code: {code!r}; STOP is separate\")\n        chars.append(PRINTABLE[code-4])\n    return \"\".join(chars)\n\n\n@dataclass(frozen=True)\nclass Question:\n    codes: tuple[int, ...]\n\n    def __post_init__(self):\n        if not isinstance(self.codes, tuple) or not 1 <= len(self.codes) <= QUESTION_CHARS:\n            raise ValueError(\"question must have 1â€“28 printable characters\")\n        if not all(printable_code(code) for code in self.codes):\n            raise ValueError(\"question contains a reserved/invalid code\")\n\n    @property\n    def bits(self) -> tuple[int, ...]:\n        result = []\n        for position in range(QUESTION_CHARS):\n            valid = int(position < len(self.codes))\n            code = self.codes[position] if valid else PAD\n            result.extend((code >> bit) & 1 for bit in range(6))\n            result.append(valid)\n        return tuple(result)\n\n\ndef encode_question(text: str) -> Question:\n    return Question(encode_text(text))\n\n\ndef alphabet_record() -> dict:\n    return {\"alphabet_id\": ALPHABET_ID, \"reserved\": {\"0\": \"PAD\", \"1\": \"BOS\", \"2\": \"RESERVED_EOS\", \"3\": \"INVALID\"},\n            \"printable\": {str(code): char for char, code in CHAR_TO_CODE.items()}, \"termination\": \"separate_stop_bit\"}\n","stderr":"","aggregated_output":"import sys, numpy as np, torch\nsys.path.insert(0, \"src\")\nfrom typed_cell.initialization import initialize\nfrom typed_cell.circuit import NumpyExecutor\nfrom typed_cell.codec import encode_question, BOS\nfrom typed_cell.topology import make_topology\ntorch.set_num_threads(2)\ndef mask_of(fn): return sum(1<<a for a in range(16) if fn(a&1,(a>>1)&1,(a>>2)&1,(a>>3)&1))\nXOR023 = mask_of(lambda x0,x1,x2,x3: x0^x2^x3)\nMUX    = mask_of(lambda x0,x1,x2,x3: x3 if x0 else x2)          # local pin 0 sve (%)
