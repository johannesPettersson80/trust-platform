{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/webview/assets.d.ts",
    "src/statechart/webview/**/*.ts",
    "src/statechart/webview/**/*.tsx",
    "src/sfc/webview/**/*.ts",
    "src/sfc/webview/**/*.tsx",
    "src/networkCanvas/webview/**/*.ts",
    "src/networkCanvas/webview/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}
